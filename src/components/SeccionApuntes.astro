---
// Componente reutilizable para páginas de categoría (Sistemas, Redes, Programación)

interface SubSeccion {
  id: string;
  icono: string;
  titulo: string;
  descripcion: string;
  apuntes: any[];
  mensajeVacio: string;
}

interface Props {
  icono: string;
  titulo: string;
  descripcion: string;
  color?: string;
  secciones: SubSeccion[];
  totalApuntes?: number;
}

const {
  icono,
  titulo,
  descripcion,
  color = 'default',
  secciones,
  totalApuntes = 0,
} = Astro.props;

const colorMap: Record<string, { accent: string; glow: string; rgb: string }> = {
  sistemas:    { accent: '#4ade80', glow: 'rgba(74,222,128,0.35)',  rgb: '74,222,128' },
  redes:       { accent: '#38bdf8', glow: 'rgba(56,189,248,0.35)',  rgb: '56,189,248' },
  programacion:{ accent: '#a78bfa', glow: 'rgba(167,139,250,0.35)', rgb: '167,139,250' },
  default:     { accent: '#4ade80', glow: 'rgba(74,222,128,0.35)',  rgb: '74,222,128' },
};
const theme = colorMap[color] ?? colorMap.default;
---

<main class="cat-page-container">

  <!-- HERO DE CATEGORÍA PREMIUM -->
  <section class={`cat-hero cat-hero--${color}`} style={`--cat-accent: ${theme.accent}; --cat-glow: ${theme.glow}; --cat-rgb: ${theme.rgb};`}>
    <!-- Elementos decorativos de fondo -->
    <div class="cat-hero-noise"></div>
    <div class="cat-hero-orb cat-hero-orb--main"></div>
    <div class="cat-hero-orb cat-hero-orb--secondary"></div>
    <div class="cat-hero-grid"></div>

    <div class="cat-hero-content">
      <div class="cat-icon-wrapper reveal">
        <span class="cat-icono">{icono}</span>
        <div class="cat-icon-ring"></div>
      </div>

      <div class="cat-hero-text reveal reveal-delay-1">
        <div class="cat-breadcrumb">
          <a href="/">Inicio</a>
          <span class="breadcrumb-sep">›</span>
          <span class="breadcrumb-current">{titulo}</span>
        </div>
        <h1>{titulo}</h1>
        <p class="cat-desc">{descripcion}</p>
      </div>
    </div>

    <div class="cat-meta reveal reveal-delay-2">
      <div class="cat-stat-card">
        <span class="cat-stat-num counter-num" data-target={totalApuntes}>{totalApuntes}</span>
        <span class="cat-stat-label">Apuntes</span>
      </div>
      <div class="cat-stat-divider"></div>
      <div class="cat-stat-card">
        <span class="cat-stat-num counter-num" data-target={totalApuntes * 50}>{totalApuntes * 50}</span>
        <span class="cat-stat-label">XP Disponibles</span>
      </div>
      <div class="cat-stat-divider"></div>
      <div class="cat-stat-card">
        <span class="cat-stat-num counter-num" data-target={secciones.length}>{secciones.length}</span>
        <span class="cat-stat-label">Módulos</span>
      </div>
    </div>
  </section>

  <!-- NAVEGACIÓN POR SUBSECCIONES -->
  <nav class="sub-nav reveal reveal-delay-3" aria-label="Subsecciones">
    {secciones.map(s => (
      <a href={`#${s.id}`} class={`sub-nav-pill sub-nav-pill--${color}`}>
        <span class="sub-nav-icono">{s.icono}</span>
        <span class="sub-nav-texto">
          <strong>{s.titulo}</strong>
          <small>{s.apuntes.length} apunte{s.apuntes.length !== 1 ? 's' : ''}</small>
        </span>
        <span class="sub-nav-arrow">→</span>
      </a>
    ))}
  </nav>

  <!-- SECCIONES DE APUNTES -->
  {secciones.map((s, sIndex) => (
    <section id={s.id} class="seccion-bloque">
      <div class="seccion-titulo reveal">
        <div class="seccion-icon-wrapper">
          <span class="seccion-icono">{s.icono}</span>
        </div>
        <div>
          <h2>{s.titulo}</h2>
          <p class="seccion-subtitulo">{s.descripcion}</p>
        </div>
        {s.apuntes.length > 0 && (
          <div class="seccion-count">
            <span>{s.apuntes.length}</span>
            <small>apuntes</small>
          </div>
        )}
      </div>

      {s.apuntes.length > 0 ? (
        <div class="lista-apuntes">
          {s.apuntes.map((apunte: any, i: number) => (
            <article
              class={`apunte-card tilt-card reveal reveal-delay-${Math.min(i + 1, 5)}`}
              style={`--card-accent: ${theme.accent}; --card-glow: ${theme.glow}; --card-rgb: ${theme.rgb};`}
            >
              <!-- Fondo decorativo -->
              <div class="card-bg-glow"></div>

              <div class="card-top">
                <div class="card-badges">
                  <span class={`badge-dif badge-dif--${apunte.data.dificultad.toLowerCase()}`}>
                    {apunte.data.dificultad}
                  </span>
                  <span class="badge-xp">+{apunte.data.xp_recompensa} XP</span>
                </div>
                <span class="card-numero">#{String(i + 1).padStart(2, '0')}</span>
              </div>

              <div class="card-body">
                <h3>
                  <a href={`/apuntes/${apunte.id}`}>{apunte.data.title}</a>
                </h3>
                <p class="card-desc">{apunte.data.description}</p>
              </div>

              <div class="card-footer">
                <span class="card-fecha">
                  {apunte.data.date.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
                </span>
                <a href={`/apuntes/${apunte.id}`} class="card-cta magnetic">
                  <span>Estudiar</span>
                  <svg class="cta-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>

              <!-- Línea de acento inferior -->
              <div class="card-accent-line"></div>
            </article>
          ))}
        </div>
      ) : (
        <div class="sin-apuntes reveal">
          <div class="sin-apuntes-icon">📝</div>
          <p>{s.mensajeVacio}</p>
          <span class="sin-apuntes-badge">Próximamente</span>
        </div>
      )}
    </section>
  ))}

</main>

<style>
  /* ── CONTENEDOR PRINCIPAL ── */
  .cat-page-container {
    max-width: 1480px;
    width: 100%;
    margin: 0 auto;
    padding: 2.5rem 2rem 6rem;
  }

  /* ══════════════════════════════════════════════
     HERO DE CATEGORÍA
  ══════════════════════════════════════════════ */
  .cat-hero {
    position: relative;
    border-radius: 24px;
    padding: 3.5rem 3rem;
    margin-bottom: 2rem;
    overflow: hidden;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
    border: 1px solid rgba(255,255,255,0.08);
    background: linear-gradient(145deg, 
      rgba(18,20,30,0.95) 0%,
      rgba(10,12,18,0.98) 100%);
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.04) inset,
      0 32px 64px rgba(0,0,0,0.5),
      0 0 80px -20px var(--cat-glow, rgba(74,222,128,0.2));
  }

  /* Ruido de textura sutil */
  .cat-hero-noise {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    opacity: 0.4;
  }

  /* Orbs de luz */
  .cat-hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
  }

  .cat-hero-orb--main {
    width: 500px;
    height: 300px;
    top: -100px;
    right: -100px;
    background: radial-gradient(circle, var(--cat-glow, rgba(74,222,128,0.2)) 0%, transparent 70%);
    opacity: 0.6;
  }

  .cat-hero-orb--secondary {
    width: 300px;
    height: 200px;
    bottom: -50px;
    left: 100px;
    background: radial-gradient(circle, rgba(var(--cat-rgb, 74,222,128), 0.08) 0%, transparent 70%);
    opacity: 0.5;
  }

  /* Grid decorativo */
  .cat-hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 70% 100% at 100% 50%, #000 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 70% 100% at 100% 50%, #000 20%, transparent 80%);
    pointer-events: none;
  }

  /* Contenido del hero */
  .cat-hero-content {
    display: flex;
    align-items: center;
    gap: 2rem;
    position: relative;
    z-index: 1;
    flex: 1;
    min-width: 0;
  }

  /* Icono con anillo */
  .cat-icon-wrapper {
    position: relative;
    flex-shrink: 0;
  }

  .cat-icono {
    display: block;
    font-size: 3.5rem;
    line-height: 1;
    filter: drop-shadow(0 0 20px var(--cat-glow, rgba(74,222,128,0.4)));
    position: relative;
    z-index: 1;
  }

  .cat-icon-ring {
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    border: 1.5px solid var(--cat-accent, #4ade80);
    opacity: 0.25;
    animation: ringPulse 3s ease-in-out infinite;
  }

  @keyframes ringPulse {
    0%, 100% { transform: scale(1); opacity: 0.25; }
    50% { transform: scale(1.1); opacity: 0.5; }
  }

  /* Texto del hero */
  .cat-hero-text {
    min-width: 0;
  }

  /* Breadcrumb */
  .cat-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-bottom: 0.6rem;
  }

  .cat-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .cat-breadcrumb a:hover {
    color: var(--cat-accent, #4ade80);
  }

  .breadcrumb-sep {
    opacity: 0.4;
  }

  .breadcrumb-current {
    color: var(--cat-accent, #4ade80);
    font-weight: 600;
  }

  .cat-hero h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
    line-height: 1.1;
    color: #fff;
    -webkit-text-fill-color: #fff;
    background: none;
  }

  .cat-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin: 0;
    max-width: 540px;
    line-height: 1.65;
  }

  /* Stats del hero */
  .cat-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 1;
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 1rem 1.5rem;
    backdrop-filter: blur(16px);
  }

  .cat-stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    text-align: center;
    min-width: 70px;
  }

  .cat-stat-num {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--cat-accent, #4ade80);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-mono);
    letter-spacing: -0.03em;
  }

  .cat-stat-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .cat-stat-divider {
    width: 1px;
    height: 36px;
    background: rgba(255,255,255,0.08);
  }

  /* ══════════════════════════════════════════════
     SUB-NAVEGACIÓN
  ══════════════════════════════════════════════ */
  .sub-nav {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .sub-nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    padding: 0.75rem 1.1rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    flex: 1;
    min-width: 200px;
    position: relative;
    overflow: hidden;
  }

  .sub-nav-pill::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(var(--cat-rgb, 74,222,128), 0.05) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .sub-nav-pill:hover::before {
    opacity: 1;
  }

  .sub-nav-pill:hover {
    border-color: var(--cat-accent, #4ade80);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3), 0 0 20px var(--cat-glow, rgba(74,222,128,0.1));
  }

  .sub-nav-icono {
    font-size: 1.5rem;
    line-height: 1;
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px rgba(var(--cat-rgb, 74,222,128), 0.3));
    transition: transform 0.3s ease;
  }

  .sub-nav-pill:hover .sub-nav-icono {
    transform: scale(1.15) rotate(-5deg);
  }

  .sub-nav-texto {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
  }

  .sub-nav-texto strong {
    color: var(--text-color);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .sub-nav-texto small {
    color: var(--text-muted);
    font-size: 0.72rem;
    font-family: var(--font-mono);
  }

  .sub-nav-arrow {
    color: var(--text-muted);
    font-size: 1rem;
    transition: transform 0.3s ease, color 0.3s ease;
    flex-shrink: 0;
  }

  .sub-nav-pill:hover .sub-nav-arrow {
    transform: translateX(4px);
    color: var(--cat-accent, #4ade80);
  }

  /* ══════════════════════════════════════════════
     SECCIÓN
  ══════════════════════════════════════════════ */
  .seccion-bloque {
    margin-bottom: 4.5rem;
    scroll-margin-top: 5rem;
  }

  .seccion-titulo {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    position: relative;
  }

  /* Línea decorativa activa bajo la sección */
  .seccion-titulo::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 80px;
    height: 1px;
    background: var(--accent-color);
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .seccion-icon-wrapper {
    background: rgba(var(--cat-rgb, 74,222,128), 0.08);
    border: 1px solid rgba(var(--cat-rgb, 74,222,128), 0.2);
    border-radius: 12px;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .seccion-icono {
    font-size: 1.5rem;
    line-height: 1;
  }

  .seccion-titulo h2 {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 0.25rem;
    color: var(--text-color);
    -webkit-text-fill-color: var(--text-color);
    background: none;
  }

  .seccion-subtitulo {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin: 0;
    line-height: 1.5;
  }

  .seccion-count {
    margin-left: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(var(--cat-rgb, 74,222,128), 0.06);
    border: 1px solid rgba(var(--cat-rgb, 74,222,128), 0.15);
    border-radius: 12px;
    padding: 0.5rem 1rem;
    min-width: 56px;
  }

  .seccion-count span {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--accent-color);
    font-family: var(--font-mono);
    line-height: 1;
  }

  .seccion-count small {
    font-size: 0.6rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  /* ══════════════════════════════════════════════
     GRID DE TARJETAS
  ══════════════════════════════════════════════ */
  .lista-apuntes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.25rem;
  }

  /* ══════════════════════════════════════════════
     TARJETA DE APUNTE — DISEÑO PREMIUM
  ══════════════════════════════════════════════ */
  .apunte-card {
    background: linear-gradient(145deg, 
      rgba(22,24,36,0.9) 0%, 
      rgba(13,14,20,0.95) 100%);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 20px;
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    transition: border-color 0.3s ease,
                box-shadow 0.3s ease,
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    cursor: default;
  }

  /* Resplandor de fondo que aparece en hover */
  .card-bg-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 50% 0%, 
      rgba(var(--card-rgb, 74,222,128), 0.06) 0%, 
      transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .apunte-card:hover .card-bg-glow {
    opacity: 1;
  }

  .apunte-card:hover {
    border-color: rgba(var(--card-rgb, 74,222,128), 0.3);
    box-shadow: 
      0 20px 50px rgba(0,0,0,0.5),
      0 0 30px rgba(var(--card-rgb, 74,222,128), 0.08),
      inset 0 1px 0 rgba(255,255,255,0.06);
  }

  /* Línea de acento inferior */
  .card-accent-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, 
      transparent 0%,
      var(--card-accent, #4ade80) 50%,
      transparent 100%);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .apunte-card:hover .card-accent-line {
    transform: scaleX(1);
  }

  /* ── TOP DE LA CARD ── */
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .card-badges {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .badge-dif {
    font-size: 0.65rem;
    padding: 0.22rem 0.6rem;
    border-radius: 100px;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.07em;
    font-family: var(--font-mono);
  }

  .badge-dif--basico {
    background: rgba(74,222,128,0.12);
    color: #4ade80;
    border: 1px solid rgba(74,222,128,0.3);
    box-shadow: 0 0 8px rgba(74,222,128,0.1);
  }
  .badge-dif--intermedio {
    background: rgba(251,146,60,0.12);
    color: #fb923c;
    border: 1px solid rgba(251,146,60,0.3);
    box-shadow: 0 0 8px rgba(251,146,60,0.1);
  }
  .badge-dif--avanzado {
    background: rgba(248,113,113,0.12);
    color: #f87171;
    border: 1px solid rgba(248,113,113,0.3);
    box-shadow: 0 0 8px rgba(248,113,113,0.1);
  }
  .badge-dif--masterclass {
    background: rgba(250,204,21,0.12);
    color: #facc15;
    border: 1px solid rgba(250,204,21,0.3);
    box-shadow: 0 0 8px rgba(250,204,21,0.1);
  }

  .badge-xp {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--card-accent, #4ade80);
    background: rgba(var(--card-rgb, 74,222,128), 0.08);
    border: 1px solid rgba(var(--card-rgb, 74,222,128), 0.2);
    padding: 0.22rem 0.5rem;
    border-radius: 100px;
    letter-spacing: 0.03em;
  }

  .card-numero {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    opacity: 0.4;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-left: auto;
    flex-shrink: 0;
  }

  /* ── BODY DE LA CARD ── */
  .card-body {
    flex: 1;
  }

  .card-body h3 {
    margin: 0 0 0.6rem;
  }

  .card-body h3 a {
    color: #e8e8f0;
    text-decoration: none;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.35;
    transition: color 0.2s;
    -webkit-text-fill-color: #e8e8f0;
    background: none;
    display: block;
  }

