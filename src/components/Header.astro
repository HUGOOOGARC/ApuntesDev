---
---
<header>
  <div class="header-container">
    <nav>
      <a href="/">Inicio</a>
      <a href="/sistemas">Sistemas</a>
      <a href="/programacion">Programación</a>
      <!-- Añade las demás categorías aquí -->
    </nav>

    <!-- Nueva barra de búsqueda -->
    <form action="/buscar" method="GET" class="buscador-form">
      <input 
        type="search" 
        name="q" 
        placeholder="Buscar apuntes o comandos..." 
        required 
        autocomplete="off"
      />
      <button type="submit">🔍</button>
    </form>
  </div>
</header>

<style>
  header {
    background-color: #1e1e1e;
    border-bottom: 2px solid var(--accent-color);
    margin-bottom: 2rem;
    padding: 1rem 2rem;
  }
  .header-container {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  nav a {
    color: var(--text-color);
    text-decoration: none;
    font-weight: bold;
    transition: color 0.2s;
  }
  nav a:hover {
    color: var(--accent-color);
  }
  .buscador-form {
    display: flex;
    gap: 0.5rem;
  }
  .buscador-form input {
    background: var(--bg-color);
    border: 1px solid #444;
    color: #fff;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    font-family: inherit;
  }
  .buscador-form input:focus {
    outline: none;
    border-color: var(--accent-color);
  }
  .buscador-form button {
    background: var(--accent-color);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    padding: 0.4rem 0.8rem;
  }
</style>