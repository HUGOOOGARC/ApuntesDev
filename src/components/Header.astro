---
import BarraProgreso from './BarraProgreso.tsx';
---

<header class="main-header">
  <div class="header-inner">
    
    <!-- Logo & Brand -->
    <a href="/" class="brand-link" aria-label="Ir a Inicio de ApuntesDev">
      <div class="logo-wrapper">
        <img src="/logo.png" alt="Logo ApuntesDev" class="logo-img" />
      </div>
      <div class="brand-info">
        <span class="brand-name">Apuntes<span class="brand-accent">Dev</span></span>
        <span class="brand-tag">SMR & CODE</span>
      </div>
    </a>

    <!-- Menú de Navegación Central -->
    <nav class="nav-links" id="nav-links" aria-label="Navegación principal">
      <a href="/sistemas" class="nav-pill" title="Sistemas Operativos Monopuesto y Red">
        <span class="pill-icon">🖥️</span>
        <span class="pill-text">Sistemas</span>
      </a>
      <a href="/redes" class="nav-pill" title="Redes de Área Local y Servicios">
        <span class="pill-icon">🌐</span>
        <span class="pill-text">Redes</span>
      </a>
      <a href="/programacion" class="nav-pill" title="Fundamentos de Programación y Web">
        <span class="pill-icon">💻</span>
        <span class="pill-text">Código</span>
      </a>
      <a href="/herramientas" class="nav-pill" title="Herramientas del Técnico (Subnetting, Chmod, Terminal)">
        <span class="pill-icon">🛠️</span>
        <span class="pill-text">Tools</span>
      </a>
      <a href="/ranking" class="nav-pill nav-pill--ranking" title="Leaderboard de Estudiantes">
        <span class="pill-icon">🏆</span>
        <span class="pill-text">Ranking</span>
      </a>
      <a href="/duelo" class="nav-pill nav-pill--duelo" title="Modo Desafío Técnico 1 vs 1">
        <span class="pill-icon">⚔️</span>
        <span class="pill-text">Arena</span>
      </a>
      <a href="/tienda" class="nav-pill nav-pill--tienda" title="Tienda de Temas, Boosters y Títulos">
        <span class="pill-icon">🏪</span>
        <span class="pill-text">Tienda</span>
      </a>
      <a href="/certificados" class="nav-pill nav-pill--cert" title="Diplomas Oficiales y Certificaciones con QR">
        <span class="pill-icon">🎓</span>
        <span class="pill-text">Diplomas</span>
      </a>
    </nav>

    <!-- Acciones Derecha: Buscador + HUD XP + Perfil + Hamburguesa -->
    <div class="header-actions">
      <!-- Buscador Compacto -->
      <form action="/buscar" method="GET" class="search-box">
        <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
        <input 
          type="search" 
          name="q" 
          placeholder="Buscar..." 
          required 
          autocomplete="off" 
          aria-label="Buscar apuntes"
        />
        <span class="search-shortcut">⌘K</span>
      </form>

      <!-- HUD Gamificado Integrado (Nivel, XP y Monedas) -->
      <div class="header-hud">
        <BarraProgreso client:load />
      </div>

      <!-- Botón de Perfil con Avatar -->
      <a href="/perfil" class="profile-card" id="link-perfil" title="Ver mi Perfil y Rango">
        <span class="profile-icon">👨‍💻</span>
        <span id="nav-username" class="profile-alias">Mi Perfil</span>
      </a>

      <!-- Botón Hamburguesa para Móvil -->
      <button class="hamburger-btn" id="hamburger-btn" aria-label="Abrir menú de navegación" aria-expanded="false">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer Desplegable -->
  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="drawer-backdrop" id="drawer-backdrop"></div>
    <nav class="drawer-nav" aria-label="Menú móvil">
      <div class="drawer-header">
        <div class="drawer-brand">
          <span class="drawer-logo">⚡</span>
          <span class="drawer-title">ApuntesDev</span>
        </div>
        <button class="drawer-close" id="drawer-close" aria-label="Cerrar menú">✕</button>
      </div>

      <div class="drawer-body">
        <span class="drawer-section-title">Contenido Académico</span>
        <a href="/sistemas" class="drawer-link">
          <span class="drawer-link-icon">🖥️</span>
          <div class="drawer-link-info">
            <span class="drawer-link-title">Sistemas Informáticos</span>
            <span class="drawer-link-desc">SOM & SOR, Linux, Windows Server</span>
          </div>
        </a>
        <a href="/redes" class="drawer-link">
          <span class="drawer-link-icon">🌐</span>
          <div class="drawer-link-info">
            <span class="drawer-link-title">Redes de Comunicación</span>
            <span class="drawer-link-desc">Cisco, Subnetting, Protocolos, Routing</span>
          </div>
        </a>
        <a href="/programacion" class="drawer-link">
          <span class="drawer-link-icon">💻</span>
          <div class="drawer-link-info">
            <span class="drawer-link-title">Programación & Código</span>
            <span class="drawer-link-desc">Python, Web, Bases de Datos</span>
          </div>
        </a>
        <a href="/herramientas" class="drawer-link">
          <span class="drawer-link-icon">🛠️</span>
          <div class="drawer-link-info">
            <span class="drawer-link-title">Herramientas del Técnico</span>
            <span class="drawer-link-desc">Calculadora IPv4, Chmod, Terminal</span>
          </div>
        </a>

        <div class="drawer-divider"></div>

        <span class="drawer-section-title">Zona Competitiva</span>
        <a href="/ranking" class="drawer-link drawer-link--ranking">
          <span class="drawer-link-icon">🏆</span>
          <div class="drawer-link-info">
            <span class="drawer-link-title">Leaderboard / Ranking</span>
            <span class="drawer-link-desc">Top cadetes y cuadro de honor</span>
          </div>
        </a>
        <a href="/duelo" class="drawer-link drawer-link--duelo">
          <span class="drawer-link-icon">⚔️</span>
          <div class="drawer-link-info">
            <span class="drawer-link-title">Arena de Duelo 1v1</span>
            <span class="drawer-link-desc">Enfréntate a la IA técnica</span>
          </div>
        </a>
        <a href="/tienda" class="drawer-link drawer-link--tienda">
          <span class="drawer-link-icon">🏪</span>
          <div class="drawer-link-info">
            <span class="drawer-link-title">Tienda Cyber</span>
            <span class="drawer-link-desc">Temas, Boosters XP, Títulos</span>
          </div>
        </a>
        <a href="/certificados" class="drawer-link drawer-link--cert">
          <span class="drawer-link-icon">🎓</span>
          <div class="drawer-link-info">
            <span class="drawer-link-title">Certificaciones & Diplomas</span>
            <span class="drawer-link-desc">Credenciales oficiales con QR</span>
          </div>
        </a>

        <div class="drawer-divider"></div>

        <a href="/perfil" class="drawer-link drawer-link--perfil">
          <span class="drawer-link-icon">👨‍💻</span>
          <div class="drawer-link-info">
            <span class="drawer-link-title">Mi Terminal de Perfil</span>
            <span class="drawer-link-desc">Estadísticas, Prestigio y Logros</span>
          </div>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  import { supabase } from '../lib/supabase';

  document.addEventListener('astro:page-load', async () => {
    const navUsername = document.getElementById('nav-username');
    if (navUsername) {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (session) {
          const { data } = await supabase
            .from('profiles')
            .select('username')
            .eq('id', session.user.id)
            .single();
          if (data && data.username) {
            navUsername.textContent = data.username;
          }
        }
      } catch (e) {
        console.error('Error cargando el nombre de usuario en el header:', e);
      }
    }

    // Lógica del menú Hamburguesa
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const mobileDrawer = document.getElementById('mobile-drawer');
    const drawerBackdrop = document.getElementById('drawer-backdrop');
    const drawerClose = document.getElementById('drawer-close');

    function openDrawer() {
      mobileDrawer?.classList.add('open');
      hamburgerBtn?.classList.add('active');
      hamburgerBtn?.setAttribute('aria-expanded', 'true');
      mobileDrawer?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      mobileDrawer?.classList.remove('open');
      hamburgerBtn?.classList.remove('active');
      hamburgerBtn?.setAttribute('aria-expanded', 'false');
      mobileDrawer?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    hamburgerBtn?.addEventListener('click', () => {
      const isOpen = mobileDrawer?.classList.contains('open');
      isOpen ? closeDrawer() : openDrawer();
    });

    drawerBackdrop?.addEventListener('click', closeDrawer);
    drawerClose?.addEventListener('click', closeDrawer);

    mobileDrawer?.querySelectorAll('.drawer-link').forEach(link => {
      link.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileDrawer?.classList.contains('open')) {
        closeDrawer();
      }
    });
  });
</script>

<style>
  /* ── HEADER CONTAINER STICKY & BLUR ── */
  .main-header {
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(9, 10, 15, 0.9);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
  }

  /* Línea cibernética animada en el borde inferior */
  .main-header::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(
      90deg, 
      transparent 0%, 
      rgba(74, 222, 128, 0.25) 20%, 
      var(--accent-color) 50%, 
      rgba(56, 189, 248, 0.25) 80%, 
      transparent 100%
    );
    opacity: 0.75;
    background-size: 200% 100%;
    animation: scanGlow 6s linear infinite;
  }

  @keyframes scanGlow {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  /* ── CONTENEDOR INTERNO ULTRA ADAPTABLE ── */
  .header-inner {
    max-width: 1600px;
    width: 100%;
    margin: 0 auto;
    padding: 0.5rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  /* ── LOGO & MARCA ── */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    flex-shrink: 0;
    white-space: nowrap;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand-link:hover {
    transform: translateY(-1px) scale(1.02);
  }

  .logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-img {
    height: 34px;
    width: auto;
    filter: drop-shadow(0 0 8px var(--accent-glow));
    transition: filter 0.3s ease;
  }

  .brand-link:hover .logo-img {
    filter: drop-shadow(0 0 16px var(--accent-color));
  }

  .brand-info {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-size: 1.12rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .brand-accent {
    color: var(--accent-color);
    text-shadow: 0 0 12px var(--accent-glow);
  }

  .brand-tag {
    font-size: 0.55rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    font-family: var(--font-mono);
  }

  /* ── NAVEGACIÓN CENTRAL ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.25rem 0.4rem;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    padding: 0.35rem 0.65rem;
    border-radius: 100px;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  .nav-pill:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-1px);
  }

  .nav-pill--ranking { color: #ffd700; }
  .nav-pill--ranking:hover {
    background: rgba(255, 215, 0, 0.12);
    box-shadow: 0 0 12px rgba(255, 215, 0, 0.2);
  }

  .nav-pill--duelo { color: #f43f5e; }
  .nav-pill--duelo:hover {
    background: rgba(244, 63, 94, 0.12);
    box-shadow: 0 0 12px rgba(244, 63, 94, 0.25);
  }

  .nav-pill--tienda { color: #38bdf8; }
  .nav-pill--tienda:hover {
    background: rgba(56, 189, 248, 0.12);
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.25);
  }

  .nav-pill--cert { color: #c084fc; }
  .nav-pill--cert:hover {
    background: rgba(192, 132, 252, 0.12);
    box-shadow: 0 0 12px rgba(192, 132, 252, 0.25);
  }

  .pill-icon {
    font-size: 0.95rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .pill-text {
    white-space: nowrap;
  }

  /* ── ACCIONES DERECHA ── */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
  }

  /* ── BUSCADOR ── */
  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .search-icon {
    position: absolute;
    left: 0.7rem;
    color: var(--text-muted);
    pointer-events: none;
    transition: color 0.2s;
  }

  .search-box:focus-within .search-icon {
    color: var(--accent-color);
  }

  .search-box input {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
    padding: 0.38rem 2.2rem 0.38rem 1.95rem;
    border-radius: 100px;
    font-family: inherit;
    font-size: 0.78rem;
    width: 120px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
  }

  .search-box input:focus {
    width: 170px;
    background: rgba(15, 17, 25, 0.96);
    border-color: var(--accent-color);
    box-shadow: 0 0 0 2px rgba(74, 222, 128, 0.15), 0 0 16px var(--accent-glow);
  }

  .search-box input::placeholder {
    color: var(--text-muted);
  }

  .search-shortcut {
    position: absolute;
    right: 0.5rem;
    font-size: 0.6rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.1rem 0.28rem;
    border-radius: 4px;
    pointer-events: none;
  }

  /* ── HUD GAMIFICADO ── */
  .header-hud {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* ── PERFIL CARD ── */
  .profile-card {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    padding: 0.35rem 0.75rem;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .profile-card:hover {
    border-color: var(--accent-color);
    background: rgba(74, 222, 128, 0.12);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px var(--accent-glow);
    color: var(--accent-color);
  }

  .profile-icon {
    font-size: 0.9rem;
    line-height: 1;
  }

  .profile-alias {
    max-width: 90px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── HAMBURGER BUTTON (MOBILE) ── */
  .hamburger-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    cursor: pointer;
    padding: 0;
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .hamburger-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--accent-color);
  }

  .hamburger-line {
    display: block;
    width: 17px;
    height: 2px;
    background: #e2e8f0;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .hamburger-btn.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg) translate(4px, 4px);
  }
  .hamburger-btn.active .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger-btn.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg) translate(4px, -4px);
  }

  /* ── MOBILE DRAWER ── */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    pointer-events: none;
  }

  .mobile-drawer.open {
    pointer-events: all;
  }

  .drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mobile-drawer.open .drawer-backdrop {
    opacity: 1;
  }

  .drawer-nav {
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    max-width: 86vw;
    height: 100%;
    background: #0d0f17;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: -10px 0 50px rgba(0, 0, 0, 0.8);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-drawer.open .drawer-nav {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .drawer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .drawer-logo {
    color: var(--accent-color);
    font-size: 1.1rem;
  }

  .drawer-title {
    font-size: 1rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .drawer-close {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    width: 32px;
    height: 32px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .drawer-close:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }

  .drawer-body {
    padding: 1rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .drawer-section-title {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    font-family: var(--font-mono);
    padding: 0.5rem 0.75rem 0.25rem;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.65rem 0.75rem;
    border-radius: 10px;
    color: #e2e8f0;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .drawer-link:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    transform: translateX(3px);
  }

  .drawer-link-icon {
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .drawer-link-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .drawer-link-title {
    font-size: 0.88rem;
    font-weight: 700;
  }

  .drawer-link-desc {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .drawer-link--ranking .drawer-link-title { color: #ffd700; }
  .drawer-link--duelo .drawer-link-title { color: #f43f5e; }
  .drawer-link--tienda .drawer-link-title { color: #38bdf8; }
  .drawer-link--cert .drawer-link-title { color: #f59e0b; }
  .drawer-link--perfil .drawer-link-title { color: var(--accent-color); }

  .drawer-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.06);
