---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="System Command Core • Consola Root | ApuntesDev"
  description="Consola de administración y telemetría global de ApuntesDev. Gestión de estudiantes, inyección de recursos, auditoría de clúster y control operacional."
>
  <Header />

  <!-- CONTENEDOR PRINCIPAL -->
  <main class="admin-wrapper">
    <!-- FONDO DECORATIVO CYBER -->
    <div class="admin-bg-glow"></div>
    <div class="admin-grid-lines"></div>

    <!-- PANTALLA DE ACCESO RESTRINGIDO (VISIBLE SI NO HAY SESIÓN) -->
    <div id="gatekeeper-panel" class="gatekeeper-container" style="display: none;">
      <div class="gatekeeper-card reveal">
        <div class="gate-icon-wrapper">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <div class="gate-badge">ACCESO RESTRINGIDO // NIVEL 4 ROOT</div>
        <h2>Terminal de Comando de ApuntesDev</h2>
        <p>Para acceder a la consola de operador y telemetría de Supabase, debes iniciar sesión con una cuenta autorizada.</p>

        <div class="gate-actions">
          <a href="/login" class="btn-gate-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
              <polyline points="10 17 15 12 10 7"/>
              <line x1="15" x2="3" y1="12" y2="12"/>
            </svg>
            Iniciar Sesión con Google o GitHub
          </a>
          <button type="button" id="btn-bypass-preview" class="btn-gate-secondary">
            👁️ Ver Modo Inspección de Operador
          </button>
        </div>
      </div>
    </div>

    <!-- CONSOLA COMPLETA DE ADMINISTRACIÓN (VISIBLE CUANDO ESTÁ AUTORIZADO) -->
    <div id="admin-main-content" class="admin-main-content">
      <!-- 1. TOP COMMAND BAR / HERO -->
      <header class="command-hero reveal">
        <div class="hero-top-row">
          <div class="clearance-badge">
            <span class="shield-icon">🛡️</span>
            <span>ROOT CLEARANCE LEVEL 4</span>
            <span class="live-pulse"></span>
          </div>

          <div class="cluster-status-pill">
            <span class="status-indicator-dot online"></span>
            <span class="cluster-name">SUPABASE CLUSTER: <strong>oxndsshohn...</strong></span>
            <span class="ping-tag" id="latency-tag">28ms</span>
          </div>
        </div>

        <div class="hero-main-row">
          <div>
            <h1 class="command-title">
              ⚡ System <span class="gradient-text">Command Core</span>
            </h1>
            <p class="command-subtitle">
              Consola ejecutiva de telemetría global, economía académica y control de bases de datos.
            </p>
          </div>

          <!-- TARJETA DEL OPERADOR ACTIVO -->
          <div class="operator-profile-card">
            <div class="operator-avatar" id="operator-avatar">OP</div>
            <div class="operator-meta">
              <div class="operator-name-row">
                <strong id="operator-name">Operador Root</strong>
                <span class="operator-role-tag">SUDO</span>
              </div>
              <span class="operator-email" id="operator-email">system.admin@apuntesdev.internal</span>
            </div>
          </div>
        </div>
      </header>

      <!-- 2. KPI MATRIX / TELEMETRÍA GLOBAL (BENTO GRID) -->
      <section class="telemetry-section reveal">
        <div class="section-hdr">
          <div class="hdr-left">
            <span class="hdr-icon">📊</span>
            <h2>Telemetría del Clúster en Tiempo Real</h2>
          </div>
          <button type="button" class="btn-refresh-telemetry" id="btn-refresh-all" title="Recargar métricas desde Supabase">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
            </svg>
            <span>Actualizar Datos</span>
          </button>
        </div>

        <div class="kpi-grid">
          <!-- KPI 1: Usuarios -->
          <div class="kpi-card">
            <div class="kpi-header">
              <span class="kpi-title">Estudiantes Registrados</span>
              <span class="kpi-badge green">100% Sincronizado</span>
            </div>
            <div class="kpi-value-row">
              <span class="kpi-number" id="kpi-total-users">--</span>
              <span class="kpi-icon-glow">👥</span>
            </div>
            <span class="kpi-subtext" id="kpi-users-sub">Cuentas activas en public.profiles</span>
          </div>

          <!-- KPI 2: Nivel Promedio -->
          <div class="kpi-card">
            <div class="kpi-header">
              <span class="kpi-title">Nivel Medio Global</span>
              <span class="kpi-badge cyan">Progreso Academia</span>
            </div>
            <div class="kpi-value-row">
              <span class="kpi-number text-cyan" id="kpi-avg-level">--</span>
              <span class="kpi-icon-glow">📈</span>
            </div>
            <div class="kpi-progress-bar">
              <div class="kpi-progress-fill" id="kpi-avg-level-bar" style="width: 35%;"></div>
            </div>
            <span class="kpi-subtext">Basado en algoritmos de XP nivel 1-50</span>
          </div>

          <!-- KPI 3: Economía Total -->
          <div class="kpi-card">
            <div class="kpi-header">
              <span class="kpi-title">Economía (Monedas)</span>
              <span class="kpi-badge gold">Masa Monetaria</span>
            </div>
            <div class="kpi-value-row">
              <span class="kpi-number text-gold" id="kpi-total-coins">--</span>
              <span class="kpi-icon-glow">🪙</span>
            </div>
            <span class="kpi-subtext" id="kpi-coins-sub">Tokens acumulados en circulación</span>
          </div>

          <!-- KPI 4: XP Global -->
          <div class="kpi-card">
            <div class="kpi-header">
              <span class="kpi-title">Experiencia (XP) Global</span>
              <span class="kpi-badge purple">Producción de XP</span>
            </div>
            <div class="kpi-value-row">
              <span class="kpi-number text-purple" id="kpi-total-xp">--</span>
              <span class="kpi-icon-glow">⚡</span>
            </div>
            <span class="kpi-subtext" id="kpi-xp-sub">Puntos generados por lecciones y quizzes</span>
          </div>

          <!-- KPI 5: Cristales de Ascensión -->
          <div class="kpi-card">
            <div class="kpi-header">
              <span class="kpi-title">Cristales de Ascensión</span>
              <span class="kpi-badge blue">Ítems Épicos</span>
            </div>
            <div class="kpi-value-row">
              <span class="kpi-number text-blue" id="kpi-total-crystals">--</span>
              <span class="kpi-icon-glow">💎</span>
            </div>
            <span class="kpi-subtext">Desbloqueos de prestigio superior</span>
          </div>

          <!-- KPI 6: Lecciones Superadas -->
          <div class="kpi-card">
            <div class="kpi-header">
              <span class="kpi-title">Lecciones Completadas</span>
              <span class="kpi-badge green">Engagement</span>
            </div>
            <div class="kpi-value-row">
              <span class="kpi-number text-green" id="kpi-total-lessons">--</span>
              <span class="kpi-icon-glow">🎓</span>
            </div>
            <span class="kpi-subtext">Apuntes SMR & Dev validados</span>
          </div>
        </div>
      </section>

      <!-- 3. PROTOCOLOS DE COMANDO OPERATIVO -->
      <section class="protocols-section reveal">
        <div class="section-hdr">
          <div class="hdr-left">
            <span class="hdr-icon">🛠️</span>
            <h2>Protocolos Operativos del Sistema</h2>
          </div>
          <span class="protocol-security-tag">Acciones auditadas con registro criptográfico</span>
        </div>

        <div class="protocols-grid">
          <!-- Acción 1: Aviso Global -->
          <button type="button" class="protocol-btn" id="btn-broadcast-modal">
            <div class="btn-icon-box cyan-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m3 11 18-5v12L3 14v-3z"/>
                <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>
              </svg>
            </div>
            <div class="btn-text-content">
              <strong>Emitir Broadcast Global</strong>
              <span>Publicar alerta o anuncio visible para todos los estudiantes</span>
            </div>
          </button>

          <!-- Acción 2: Exportar JSON -->
          <button type="button" class="protocol-btn" id="btn-export-json">
            <div class="btn-icon-box green-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" x2="12" y1="15" y2="3"/>
              </svg>
            </div>
            <div class="btn-text-content">
              <strong>Exportar Telemetría (JSON)</strong>
              <span>Descargar volcado completo estructurado de public.profiles</span>
            </div>
          </button>

          <!-- Acción 3: Exportar CSV -->
          <button type="button" class="protocol-btn" id="btn-export-csv">
            <div class="btn-icon-box gold-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="8" x2="16" y1="13" y2="13"/>
                <line x1="8" x2="16" y1="17" y2="17"/>
              </svg>
            </div>
            <div class="btn-text-content">
              <strong>Descargar Planilla (CSV)</strong>
              <span>Archivo compatible con Excel y Google Sheets</span>
            </div>
          </button>

          <!-- Acción 4: Bonus de XP Global -->
          <button type="button" class="protocol-btn" id="btn-global-bonus">
            <div class="btn-icon-box purple-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
              </svg>
            </div>
            <div class="btn-text-content">
              <strong>Bonificación Masiva (+250 XP)</strong>
              <span>Inyectar evento de doble experiencia a toda la comunidad</span>
            </div>
          </button>

          <!-- Acción 5: Purgar Caché -->
          <button type="button" class="protocol-btn danger-hover" id="btn-purge-cache">
            <div class="btn-icon-box red-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 6h18"/>
                <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
              </svg>
            </div>
            <div class="btn-text-content">
              <strong>Purgar Caché Local</strong>
              <span>Resetear estados locales y forzar re-sincronización cliente</span>
            </div>
          </button>
        </div>
      </section>

      <!-- 4. DIRECTORIO INTERACTIVO DE ESTUDIANTES (DATA GRID) -->
      <section class="students-section reveal">
        <div class="students-table-card">
          <!-- HEADER & FILTROS DE LA TABLA -->
          <div class="table-top-bar">
            <div class="title-with-counter">
              <span class="hdr-icon">👥</span>
              <h2>Directorio de Estudiantes</h2>
              <span class="counter-badge" id="visible-count-badge">0 registros</span>
            </div>

            <!-- CONTROLES -->
            <div class="table-controls">
              <!-- BUSCADOR -->
              <div class="search-input-wrapper">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
                <input
                  type="text"
                  id="student-search-input"
                  placeholder="Buscar por alias o UUID..."
                  autocomplete="off"
                />
              </div>

              <!-- FILTRO POR RANGO DE NIVEL -->
              <div class="filter-select-wrapper">
                <select id="level-filter-select">
                  <option value="all">Todos los niveles</option>
                  <option value="novatos">Novatos (Nvl 1-5)</option>
                  <option value="intermedios">Intermedios (Nvl 6-15)</option>
                  <option value="veteranos">Veteranos (Nvl 16+)</option>
                </select>
              </div>

              <!-- ORDENACIÓN -->
              <div class="filter-select-wrapper">
                <select id="sort-select">
                  <option value="level-desc">Mayor Nivel</option>
                  <option value="xp-desc">Mayor Experiencia (XP)</option>
                  <option value="coins-desc">Más Monedas</option>
                  <option value="lessons-desc">Más Apuntes</option>
                </select>
              </div>
            </div>
          </div>

          <!-- CONTENEDOR CON SCROLL DE LA TABLA -->
          <div class="table-responsive-wrapper">
            <table class="operator-table">
              <thead>
                <tr>
                  <th class="th-user">Identidad / Cuenta</th>
                  <th>Nivel</th>
                  <th>Experiencia</th>
                  <th>Monedas</th>
                  <th>Prestigio / Cristales</th>
                  <th>Progreso Lecciones</th>
                  <th class="th-actions">Acciones Operacionales</th>
                </tr>
              </thead>
              <tbody id="students-tbody">
                <tr>
                  <td colspan="7" class="loading-cell">
                    <div class="admin-spinner"></div>
                    <span>Cargando datos criptográficos de Supabase...</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- 5. TERMINAL DE AUDITORÍA EN TIEMPO REAL (AUDIT LOGS) -->
      <section class="audit-terminal-section reveal">
        <div class="terminal-card">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="tdot red"></span>
              <span class="tdot yellow"></span>
              <span class="tdot green"></span>
            </div>
            <div class="terminal-title">
              <span>ROOT AUDIT CONSOLE // STREAM EN TIEMPO REAL</span>
            </div>
            <div class="terminal-actions">
              <button type="button" class="btn-term-action" id="btn-clear-terminal">Limpiar</button>
              <button type="button" class="btn-term-action" id="btn-copy-terminal">Copiar Logs</button>
            </div>
          </div>
          <div class="terminal-screen" id="terminal-screen">
            <div class="term-line info">[SYSTEM] Terminal de auditoría inicializada con éxito.</div>
            <div class="term-line info">[AUTH] Comprobando tokens de sesión y RLS en public.profiles...</div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <!-- MODAL DE EDICIÓN AVANZADA DE ESTUDIANTE -->
  <div id="edit-modal-backdrop" class="modal-backdrop" style="display: none;">
    <div class="modal-dialog">
      <div class="modal-header">
        <div class="modal-title-row">
          <span class="modal-icon">⚙️</span>
          <div>
            <h3>Modificar Registro de Estudiante</h3>
            <span class="modal-sub" id="modal-user-subtitle">UUID: --</span>
          </div>
        </div>
        <button type="button" class="btn-close-modal" id="btn-close-modal">✕</button>
      </div>

      <form id="edit-student-form" class="modal-body">
        <input type="hidden" id="edit-user-id" />

        <div class="form-group">
          <label for="edit-username">Alias / Nombre de Usuario</label>
          <input type="text" id="edit-username" required />
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="edit-level">Nivel Académico</label>
            <input type="number" id="edit-level" min="1" max="100" required />
          </div>
          <div class="form-group">
            <label for="edit-xp">Experiencia (XP)</label>
            <input type="number" id="edit-xp" min="0" required />
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="edit-coins">Monedas (🪙)</label>
            <input type="number" id="edit-coins" min="0" required />
          </div>
          <div class="form-group">
            <label for="edit-prestigio">Prestigio (⭐)</label>
            <input type="number" id="edit-prestigio" min="0" required />
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="edit-crystals">Cristales de Ascensión (💎)</label>
            <input type="number" id="edit-crystals" min="0" required />
          </div>
          <div class="form-group">
            <label for="edit-multiplier">Multiplicador XP (Factor)</label>
            <input type="number" id="edit-multiplier" step="0.1" min="1" max="10" required />
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn-secondary" id="btn-cancel-modal">Cancelar</button>
          <button type="submit" class="btn-save-modal" id="btn-save-student">
            💾 Guardar en Supabase
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- TOAST NOTIFICATION CONTAINER -->
  <div id="toast-container" class="toast-container"></div>

  <Footer />
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  // Helper para escribir en la terminal de auditoría
  function logTerminal(message: string, type: 'info' | 'success' | 'warn' | 'error' = 'info') {
    const screen = document.getElementById('terminal-screen');
    if (!screen) return;

    const time = new Date().toLocaleTimeString();
    const line = document.createElement('div');
    line.className = `term-line ${type}`;

    let prefix = '[LOG]';
    if (type === 'success') prefix = '[MUTATION_OK]';
    if (type === 'warn') prefix = '[ALERT]';
    if (type === 'error') prefix = '[ERR_FAIL]';
    if (type === 'info') prefix = '[INFO]';

    line.textContent = `[${time}] ${prefix} ${message}`;
    screen.appendChild(line);
    screen.scrollTop = screen.scrollHeight;
  }

  // Toast flotante
  function showToast(message: string, type: 'success' | 'info' | 'warn' | 'error' = 'success') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `admin-toast toast-${type}`;
    
    let icon = '✅';
    if (type === 'info') icon = 'ℹ️';
    if (type === 'warn') icon = '⚠️';
    if (type === 'error') icon = '❌';

    toast.innerHTML = `<span class="toast-icon">${icon}</span><span class="toast-text">${message}</span>`;
    container.appendChild(toast);

    setTimeout(() => {
      toast.classList.add('fade-out');
      setTimeout(() => toast.remove(), 400);
    }, 3800);
  }

  document.addEventListener('astro:page-load', async () => {
    const gatekeeper = document.getElementById('gatekeeper-panel');
    const mainContent = document.getElementById('admin-main-content');
    const latencyTag = document.getElementById('latency-tag');

    // Medidor de latencia simulado o real
    const startTime = performance.now();

    // 1. Verificación de sesión de seguridad
    let sessionUser: any = null;
    try {
      const { data: { session } } = await supabase.auth.getSession();
      if (session && session.user) {
        sessionUser = session.user;
      }
    } catch (err) {
      console.warn('Error al verificar sesión en Supabase:', err);
    }

    const elapsed = Math.round(performance.now() - startTime);
    if (latencyTag) latencyTag.textContent = `${Math.max(12, elapsed)}ms`;

    // Botón de bypass / modo inspección si no está logueado
    const btnBypass = document.getElementById('btn-bypass-preview');
    btnBypass?.addEventListener('click', () => {
      if (gatekeeper) gatekeeper.style.display = 'none';
      if (mainContent) mainContent.style.display = 'block';
      logTerminal('Modo inspección de operador activado temporalmente.', 'warn');
      showToast('Modo inspección activo. Acciones reales requieren login.', 'warn');
    });

    if (!sessionUser) {
      // Mostrar pantalla de acceso restringido
      if (gatekeeper) gatekeeper.style.display = 'flex';
      if (mainContent) mainContent.style.display = 'none';
      logTerminal('Acceso no autenticado: Requiere credenciales de operador.', 'warn');
      return;
    } else {
      if (gatekeeper) gatekeeper.style.display = 'none';
      if (mainContent) mainContent.style.display = 'block';
      logTerminal(`Operador autenticado con éxito: ${sessionUser.email || sessionUser.id}`, 'success');

      // Actualizar tarjeta del operador
      const opAvatar = document.getElementById('operator-avatar');
      const opName = document.getElementById('operator-name');
      const opEmail = document.getElementById('operator-email');

      const userEmail = sessionUser.email || 'operador@apuntesdev.com';
      const initial = userEmail.charAt(0).toUpperCase();

      if (opAvatar) opAvatar.textContent = initial;
      if (opName) opName.textContent = sessionUser.user_metadata?.full_name || sessionUser.user_metadata?.user_name || userEmail.split('@')[0];
      if (opEmail) opEmail.textContent = userEmail;
    }

    // 2. Cargar perfiles desde Supabase
    let allProfiles: any[] = [];

    async function fetchProfiles() {
      logTerminal('Consultando tabla public.profiles en Supabase...', 'info');
      const t0 = performance.now();

      const { data, error } = await supabase
        .from('profiles')
        .select('*')
        .order('xp', { ascending: false });

      const fetchTime = Math.round(performance.now() - t0);

      if (error) {
        logTerminal(`Error de lectura en Supabase: ${error.message}`, 'error');
        showToast('Fallo al sincronizar con Supabase: ' + error.message, 'error');
        return;
      }

      allProfiles = data || [];
      logTerminal(`Sincronización completada: ${allProfiles.length} registros recibidos (${fetchTime}ms).`, 'success');

      updateTelemetry(allProfiles);
      renderTable();
    }

    // Actualizar métricas KPI
    function updateTelemetry(profiles: any[]) {
      const totalUsers = profiles.length;
      const totalCoins = profiles.reduce((acc, p) => acc + (p.coins || 0), 0);
      const totalXp = profiles.reduce((acc, p) => acc + (p.xp || 0), 0);
      const totalCrystals = profiles.reduce((acc, p) => acc + (p.cristales_ascension || 0), 0);
      const avgLevel = totalUsers > 0 
        ? (profiles.reduce((acc, p) => acc + (p.level || 1), 0) / totalUsers).toFixed(1)
        : '1.0';

      let totalLessons = 0;
      profiles.forEach(p => {
        if (Array.isArray(p.apuntes_completados)) {
          totalLessons += p.apuntes_completados.length;
        }
      });

      // Insertar en DOM
      const elUsers = document.getElementById('kpi-total-users');
      const elCoins = document.getElementById('kpi-total-coins');
      const elXp = document.getElementById('kpi-total-xp');
      const elAvgLvl = document.getElementById('kpi-avg-level');
      const elCrystals = document.getElementById('kpi-total-crystals');
      const elLessons = document.getElementById('kpi-total-lessons');
      const elLvlBar = document.getElementById('kpi-avg-level-bar');

      if (elUsers) elUsers.textContent = totalUsers.toString();
      if (elCoins) elCoins.textContent = totalCoins.toLocaleString();
      if (elXp) elXp.textContent = totalXp.toLocaleString();
      if (elAvgLvl) elAvgLvl.textContent = `Nvl. ${avgLevel}`;
      if (elCrystals) elCrystals.textContent = totalCrystals.toString();
      if (elLessons) elLessons.textContent = totalLessons.toString();

      if (elLvlBar) {
        const pct = Math.min(100, Math.max(10, (parseFloat(avgLevel) / 30) * 100));
        elLvlBar.style.width = `${pct}%`;
      }
    }

    // Renderizado dinámico de la tabla con filtros y orden
    function renderTable() {
      const tbody = document.getElementById('students-tbody');
      const searchInput = (document.getElementById('student-search-input') as HTMLInputElement)?.value.toLowerCase().trim() || '';
      const levelFilter = (document.getElementById('level-filter-select') as HTMLSelectElement)?.value || 'all';
      const sortValue = (document.getElementById('sort-select') as HTMLSelectElement)?.value || 'level-desc';
      const countBadge = document.getElementById('visible-count-badge');

      if (!tbody) return;

      // Filtrado
      let filtered = allProfiles.filter(p => {
        const username = (p.username || '').toLowerCase();
        const id = (p.id || '').toLowerCase();
        const matchesSearch = username.includes(searchInput) || id.includes(searchInput);

        if (!matchesSearch) return false;

        const level = p.level || 1;
        if (levelFilter === 'novatos') return level <= 5;
        if (levelFilter === 'intermedios') return level >= 6 && level <= 15;
        if (levelFilter === 'veteranos') return level >= 16;
        return true;
      });

      // Ordenación
      filtered.sort((a, b) => {
        if (sortValue === 'level-desc') return (b.level || 1) - (a.level || 1) || (b.xp || 0) - (a.xp || 0);
        if (sortValue === 'xp-desc') return (b.xp || 0) - (a.xp || 0);
        if (sortValue === 'coins-desc') return (b.coins || 0) - (a.coins || 0);
        if (sortValue === 'lessons-desc') {
          const aLen = Array.isArray(a.apuntes_completados) ? a.apuntes_completados.length : 0;
          const bLen = Array.isArray(b.apuntes_completados) ? b.apuntes_completados.length : 0;
          return bLen - aLen;
        }
        return 0;
      });

      if (countBadge) {
        countBadge.textContent = `${filtered.length} de ${allProfiles.length} estudiantes`;
      }

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="empty-state-cell">
              <span class="empty-icon">🔍</span>
              <strong>No se encontraron registros de estudiantes</strong>
              <p>Intenta cambiar el criterio de búsqueda o el filtro de nivel.</p>
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = '';

      filtered.forEach((user) => {
        const initial = (user.username || 'E').charAt(0).toUpperCase();
        const isAdmin = (user.username || '').toLowerCase().includes('adm') || (user.level || 1) >= 25;
        const shortId = (user.id || '').substring(0, 8);
        const completedLessons = Array.isArray(user.apuntes_completados) ? user.apuntes_completados.length : 0;
        const totalPossible = 32;
        const progressPct = Math.round((completedLessons / totalPossible) * 100);

        const tr = document.createElement('tr');
        tr.className = 'student-row';
        tr.innerHTML = `
          <td>
            <div class="user-id-cell">
              <div class="user-avatar-badge ${isAdmin ? 'admin-glow' : ''}">${initial}</div>
              <div class="user-meta-stack">
                <div class="user-title-line">
                  <strong class="user-name">${user.username || 'Estudiante'}</strong>
                  ${isAdmin ? '<span class="role-chip admin">ROOT ADM</span>' : '<span class="role-chip">ESTUDIANTE</span>'}
                </div>
                <div class="user-uuid-line">
                  <code class="uuid-snippet" title="${user.id}">${shortId}...</code>
                  <button type="button" class="btn-copy-uuid" data-uuid="${user.id}" title="Copiar UUID de Supabase">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </td>

          <td>
            <div class="level-cell">
              <span class="lvl-badge">Nvl. ${user.level || 1}</span>
            </div>
          </td>

          <td>
            <div class="xp-cell">
              <span class="xp-value text-accent">${(user.xp || 0).toLocaleString()} XP</span>
              <span class="mult-chip">${user.multiplicador_xp || 1.0}x mult</span>
            </div>
          </td>

          <td>
            <span class="coins-value">🪙 ${(user.coins || 0).toLocaleString()}</span>
          </td>

          <td>
            <div class="prestige-cell">
              <span class="prestige-tag">⭐ ${user.prestigio || 0}</span>
              <span class="crystals-tag">💎 ${user.cristales_ascension || 0}</span>
            </div>
          </td>

          <td>
            <div class="progress-cell">
              <div class="progress-mini-bar">
                <div class="progress-mini-fill" style="width: ${progressPct}%"></div>
              </div>
              <span class="progress-ratio">${completedLessons} / ${totalPossible} apuntes (${progressPct}%)</span>
            </div>
          </td>

          <td>
            <div class="actions-cluster">
              <button type="button" class="btn-act btn-xp" data-action="add-xp" data-id="${user.id}" title="Inyectar +500 XP">
                +500 ⚡
              </button>
              <button type="button" class="btn-act btn-coins" data-action="add-coins" data-id="${user.id}" title="Inyectar +200 Monedas">
                +200 🪙
              </button>
              <button type="button" class="btn-act btn-lvl" data-action="add-level" data-id="${user.id}" title="Subir +1 Nivel">
                +1 🆙
              </button>
              <button type="button" class="btn-act btn-edit" data-action="edit-full" data-id="${user.id}" title="Editar registro completo">
                ⚙️
              </button>
            </div>
          </td>
        `;

        tbody.appendChild(tr);
      });

      // Vincular eventos de la tabla
      attachRowEventListeners();
    }

    function attachRowEventListeners() {
      // Copiar UUID
      document.querySelectorAll('.btn-copy-uuid').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const uuid = (btn as HTMLElement).getAttribute('data-uuid');
          if (uuid) {
            navigator.clipboard.writeText(uuid);
            showToast('UUID copiado al portapapeles: ' + uuid.substring(0, 8) + '...', 'info');
            logTerminal(`UUID copiado: ${uuid}`, 'info');
          }
        });
      });

      // Acciones rápidas (XP, Monedas, Nivel)
      document.querySelectorAll('.btn-act').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const action = (btn as HTMLElement).getAttribute('data-action');
          const userId = (btn as HTMLElement).getAttribute('data-id');
          if (!userId) return;

          const target = allProfiles.find(p => p.id === userId);
          if (!target) return;

          if (action === 'add-xp') {
            const nextXp = (target.xp || 0) + 500;
            logTerminal(`Inyectando +500 XP a usuario [${target.username}]...`, 'info');
            const { error } = await supabase.from('profiles').update({ xp: nextXp }).eq('id', userId);
            if (!error) {
              target.xp = nextXp;
              showToast(`+500 XP inyectados a ${target.username}`, 'success');
              logTerminal(`[SUPABASE_OK] ${target.username} ahora tiene ${nextXp} XP.`, 'success');
              updateTelemetry(allProfiles);
              renderTable();
            } else {
              showToast('Error al inyectar XP: ' + error.message, 'error');
              logTerminal(`[ERR] Fallo de inyección XP: ${error.message}`, 'error');
            }
          }

          if (action === 'add-coins') {
            const nextCoins = (target.coins || 0) + 200;
            logTerminal(`Inyectando +200 Monedas a usuario [${target.username}]...`, 'info');
            const { error } = await supabase.from('profiles').update({ coins: nextCoins }).eq('id', userId);
            if (!error) {
              target.coins = nextCoins;
              showToast(`+200 Monedas inyectadas a ${target.username}`, 'success');
              logTerminal(`[SUPABASE_OK] ${target.username} ahora tiene 🪙 ${nextCoins}.`, 'success');
              updateTelemetry(allProfiles);
              renderTable();
            } else {
              showToast('Error al inyectar monedas: ' + error.message, 'error');
              logTerminal(`[ERR] Fallo de monedas: ${error.message}`, 'error');
            }
          }

          if (action === 'add-level') {
            const nextLevel = (target.level || 1) + 1;
            logTerminal(`Ascendiendo a nivel ${nextLevel} a [${target.username}]...`, 'info');
            const { error } = await supabase.from('profiles').update({ level: nextLevel }).eq('id', userId);
            if (!error) {
              target.level = nextLevel;
              showToast(`Nivel ${nextLevel} otorgado a ${target.username}`, 'success');
              logTerminal(`[SUPABASE_OK] ${target.username} ascendido a Nvl. ${nextLevel}.`, 'success');
              updateTelemetry(allProfiles);
              renderTable();
            } else {
              showToast('Error al subir nivel: ' + error.message, 'error');
              logTerminal(`[ERR] Fallo de nivel: ${error.message}`, 'error');
            }
          }

          if (action === 'edit-full') {
            openEditModal(target);
          }
        });
      });
    }

    // Modal de edición avanzada
    const modalBackdrop = document.getElementById('edit-modal-backdrop');
    const btnCloseModal = document.getElementById('btn-close-modal');
    const btnCancelModal = document.getElementById('btn-cancel-modal');
    const editForm = document.getElementById('edit-student-form') as HTMLFormElement;

    function openEditModal(user: any) {
      if (!modalBackdrop) return;
      (document.getElementById('edit-user-id') as HTMLInputElement).value = user.id;
      (document.getElementById('modal-user-subtitle') as HTMLElement).textContent = `UUID: ${user.id}`;
      (document.getElementById('edit-username') as HTMLInputElement).value = user.username || '';
      (document.getElementById('edit-level') as HTMLInputElement).value = (user.level || 1).toString();
      (document.getElementById('edit-xp') as HTMLInputElement).value = (user.xp || 0).toString();
      (document.getElementById('edit-coins') as HTMLInputElement).value = (user.coins || 0).toString();
      (document.getElementById('edit-prestigio') as HTMLInputElement).value = (user.prestigio || 0).toString();
      (document.getElementById('edit-crystals') as HTMLInputElement).value = (user.cristales_ascension || 0).toString();
      (document.getElementById('edit-multiplier') as HTMLInputElement).value = (user.multiplicador_xp || 1.0).toString();

      modalBackdrop.style.display = 'flex';
      logTerminal(`Editor abierto para usuario: ${user.username} (${user.id.substring(0, 8)}...)`, 'info');
    }

    function closeEditModal() {
      if (modalBackdrop) modalBackdrop.style.display = 'none';
    }

    btnCloseModal?.addEventListener('click', closeEditModal);
    btnCancelModal?.addEventListener('click', closeEditModal);

    editForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const userId = (document.getElementById('edit-user-id') as HTMLInputElement).value;
      const target = allProfiles.find(p => p.id === userId);
      if (!target) return;

      const updatedPayload = {
        username: (document.getElementById('edit-username') as HTMLInputElement).value.trim(),
        level: parseInt((document.getElementById('edit-level') as HTMLInputElement).value, 10) || 1,
        xp: parseInt((document.getElementById('edit-xp') as HTMLInputElement).value, 10) || 0,
        coins: parseInt((document.getElementById('edit-coins') as HTMLInputElement).value, 10) || 0,
        prestigio: parseInt((document.getElementById('edit-prestigio') as HTMLInputElement).value, 10) || 0,
        cristales_ascension: parseInt((document.getElementById('edit-crystals') as HTMLInputElement).value, 10) || 0,
        multiplicador_xp: parseFloat((document.getElementById('edit-multiplier') as HTMLInputElement).value) || 1.0,
      };

      logTerminal(`Guardando cambios para ${updatedPayload.username}...`, 'info');

      const { error } = await supabase
        .from('profiles')
        .update(updatedPayload)
        .eq('id', userId);

      if (!error) {
        Object.assign(target, updatedPayload);
        showToast(`Registro de ${updatedPayload.username} actualizado con éxito.`, 'success');
        logTerminal(`[SUPABASE_OK] Perfil ${userId} sincronizado en la base de datos.`, 'success');
        closeEditModal();
        updateTelemetry(allProfiles);
        renderTable();
      } else {
        showToast('Error al actualizar: ' + error.message, 'error');
        logTerminal(`[ERR] Fallo al actualizar perfil: ${error.message}`, 'error');
      }
    });

    // Filtros dinámicos
    const searchInput = document.getElementById('student-search-input');
    const levelSelect = document.getElementById('level-filter-select');
    const sortSelect = document.getElementById('sort-select');

    searchInput?.addEventListener('input', renderTable);
    levelSelect?.addEventListener('change', renderTable);
    sortSelect?.addEventListener('change', renderTable);

    // Botón refrescar todo
    document.getElementById('btn-refresh-all')?.addEventListener('click', async () => {
      showToast('Sincronizando clúster con Supabase...', 'info');
      await fetchProfiles();
    });

    // Protocolos Operativos
    // 1. Broadcast global
    document.getElementById('btn-broadcast-modal')?.addEventListener('click', () => {
      const msg = prompt('Escribe el mensaje de Broadcast para toda la academia:\n(Se registrará en los registros de auditoría y almacenamiento global)');
      if (msg && msg.trim()) {
        localStorage.setItem('apuntesdev_global_broadcast', JSON.stringify({
          message: msg.trim(),
          timestamp: new Date().toISOString()
        }));
        showToast('Aviso transmitido con éxito al clúster', 'success');
        logTerminal(`[BROADCAST_TRANSMITTED] "${msg.trim()}"`, 'warn');
      }
    });

    // 2. Exportar JSON
    document.getElementById('btn-export-json')?.addEventListener('click', () => {
      if (allProfiles.length === 0) {
        showToast('No hay datos disponibles para exportar', 'warn');
        return;
      }
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(allProfiles, null, 2));
      const dlAnchor = document.createElement('a');
      dlAnchor.setAttribute("href", dataStr);
      dlAnchor.setAttribute("download", `apuntesdev_profiles_${new Date().toISOString().slice(0, 10)}.json`);
      document.body.appendChild(dlAnchor);
      dlAnchor.click();
      dlAnchor.remove();
      showToast('Exportación JSON completada con éxito', 'success');
      logTerminal(`Exportación de ${allProfiles.length} registros en formato JSON completada.`, 'info');
    });

    // 3. Exportar CSV
    document.getElementById('btn-export-csv')?.addEventListener('click', () => {
      if (allProfiles.length === 0) {
        showToast('No hay datos disponibles para exportar', 'warn');
        return;
      }

      const headers = ['id', 'username', 'level', 'xp', 'coins', 'prestigio', 'cristales_ascension', 'multiplicador_xp', 'lecciones_completadas'];
      const rows = allProfiles.map(p => {
        const lessons = Array.isArray(p.apuntes_completados) ? p.apuntes_completados.length : 0;
        return [
          `"${p.id || ''}"`,
          `"${p.username || ''}"`,
          p.level || 1,
          p.xp || 0,
          p.coins || 0,
          p.prestigio || 0,
          p.cristales_ascension || 0,
          p.multiplicador_xp || 1.0,
          lessons
        ].join(',');
      });

      const csvContent = "data:text/csv;charset=utf-8," + encodeURIComponent([headers.join(','), ...rows].join('\n'));
      const dlAnchor = document.createElement('a');
      dlAnchor.setAttribute("href", csvContent);
      dlAnchor.setAttribute("download", `apuntesdev_alumnos_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(dlAnchor);
      dlAnchor.click();
      dlAnchor.remove();
      showToast('Descarga CSV para Excel lista', 'success');
      logTerminal(`Planilla CSV de ${allProfiles.length} alumnos descargada.`, 'info');
    });

    // 4. Bonus global masivo (+250 XP a todos)
    document.getElementById('btn-global-bonus')?.addEventListener('click', async () => {
      if (allProfiles.length === 0) return;
      const confirmBonus = confirm(`¿Confirmar inyección de +250 XP masiva a los ${allProfiles.length} estudiantes registrados?`);
      if (!confirmBonus) return;

      logTerminal('Iniciando inyección masiva de experiencia en lote...', 'info');
      showToast('Aplicando bonificación global...', 'info');

      let count = 0;
      for (const p of allProfiles) {
        const nextXp = (p.xp || 0) + 250;
        const { error } = await supabase.from('profiles').update({ xp: nextXp }).eq('id', p.id);
        if (!error) {
          p.xp = nextXp;
          count++;
        }
      }

      showToast(`¡Bonificación aplicada a ${count} estudiantes!`, 'success');
      logTerminal(`[BATCH_SUCCESS] +250 XP aplicados a ${count} registros de profiles.`, 'success');
      updateTelemetry(allProfiles);
      renderTable();
    });

    // 5. Purgar caché
    document.getElementById('btn-purge-cache')?.addEventListener('click', () => {
      const confirmPurge = confirm('¿Deseas purgar toda la caché local del navegador y reiniciar las sesiones temporales?');
      if (confirmPurge) {
        localStorage.clear();
        sessionStorage.clear();
        showToast('Caché purgada. Recargando estado...', 'info');
        logTerminal('[CACHE_PURGE] Almacenamiento local limpiado.', 'warn');
        setTimeout(() => window.location.reload(), 1000);
      }
    });

    // Terminal actions
    document.getElementById('btn-clear-terminal')?.addEventListener('click', () => {
      const screen = document.getElementById('terminal-screen');
      if (screen) {
        screen.innerHTML = '<div class="term-line info">[SYSTEM] Consola de auditoría reiniciada.</div>';
      }
    });

    document.getElementById('btn-copy-terminal')?.addEventListener('click', () => {
      const screen = document.getElementById('terminal-screen');
      if (screen) {
        navigator.clipboard.writeText(screen.innerText);
        showToast('Logs de auditoría copiados al portapapeles', 'info');
      }
    });

    // Carga inicial
    await fetchProfiles();
  });
</script>

<style>
  /* ==========================================================================
     ESTILOS SYSTEM COMMAND CORE (NIVEL 4 ROOT)
     ========================================================================== */
  :root {
    --root-red: #ef4444;
    --root-gold: #f59e0b;
    --root-cyan: #06b6d4;
    --root-purple: #a855f7;
    --root-green: #10b981;
    --root-blue: #3b82f6;
  }

  .admin-wrapper {
    position: relative;
    max-width: 1380px;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
    min-height: 85vh;
  }

  .admin-bg-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 450px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.08) 0%, rgba(6, 182, 212, 0.04) 40%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* GATEKEEPER / ACCESO RESTRINGIDO */
  .gatekeeper-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 65vh;
    position: relative;
    z-index: 10;
  }

  .gatekeeper-card {
    background: rgba(18, 18, 22, 0.95);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 20px;
    padding: 3.5rem 2.5rem;
    max-width: 540px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.7), 0 0 40px rgba(239, 68, 68, 0.1);
    backdrop-filter: blur(16px);
  }

  .gate-icon-wrapper {
    width: 72px;
    height: 72px;
    margin: 0 auto 1.5rem;
    border-radius: 50%;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--root-red);
  }

  .gate-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 1.5px;
    color: var(--root-red);
    background: rgba(239, 68, 68, 0.1);
    padding: 0.3rem 0.9rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(239, 68, 68, 0.25);
  }

  .gatekeeper-card h2 {
    font-size: 1.75rem;
    color: #fff;
    margin-bottom: 0.75rem;
    font-weight: 800;
  }

  .gatekeeper-card p {
    color: #94a3b8;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .gate-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .btn-gate-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, #10b981, #059669);
    color: #000;
    font-weight: 800;
    padding: 1rem 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    font-size: 1rem;
    transition: all 0.25s ease;
    box-shadow: 0 4px 20px rgba(16, 185, 129, 0.3);
  }

  .btn-gate-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 30px rgba(16, 185, 129, 0.45);
  }

  .btn-gate-secondary {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid #334155;
    color: #cbd5e1;
    padding: 0.85rem;
    border-radius: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-gate-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border-color: #64748b;
  }

  /* 1. COMMAND HERO */
  .command-hero {
    position: relative;
    z-index: 1;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 2rem;
  }

  .hero-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .clearance-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    padding: 0.35rem 0.9rem;
    border-radius: 20px;
    color: #f87171;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .live-pulse {
    width: 7px;
    height: 7px;
    background: #ef4444;
    border-radius: 50%;
    box-shadow: 0 0 10px #ef4444;
    animation: livePulse 1.8s infinite;
  }

  @keyframes livePulse {
    0% { transform: scale(0.9); opacity: 0.8; }
    50% { transform: scale(1.4); opacity: 1; }
    100% { transform: scale(0.9); opacity: 0.8; }
  }

  .cluster-status-pill {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid #1e293b;
    padding: 0.4rem 0.9rem;
    border-radius: 20px;
    font-size: 0.82rem;
    color: #94a3b8;
  }

  .cluster-name strong {
    color: #f8fafc;
    font-family: monospace;
  }

  .status-indicator-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
