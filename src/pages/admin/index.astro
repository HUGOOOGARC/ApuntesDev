    color: #34d399;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .user-avatar-badge.admin-glow {
    background: linear-gradient(135deg, #ef4444, #991b1b);
    border-color: #f87171;
    color: #fff;
    box-shadow: 0 0 12px rgba(239, 68, 68, 0.35);
  }

  .user-meta-stack {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .user-title-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .user-name {
    color: #fff;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .role-chip {
    font-size: 0.65rem;
    font-weight: 800;
