  }

  .kpi-badge.green { background: rgba(16, 185, 129, 0.15); color: #34d399; }
  .kpi-badge.cyan { background: rgba(6, 182, 212, 0.15); color: #22d3ee; }
  .kpi-badge.gold { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
  .kpi-badge.purple { background: rgba(168, 85, 247, 0.15); color: #c084fc; }
  .kpi-badge.blue { background: rgba(59, 130, 246, 0.15); color: #60a5fa; }

  .kpi-value-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .kpi-number {
    font-size: 2.2rem;
    font-weight: 900;
    color: #fff;
    font-family: monospace;
    letter-spacing: -0.03em;
  }

  .kpi-icon-glow {
    font-size: 1.5rem;
    opacity: 0.6;
  }

  .text-cyan { color: #22d3ee; }
  .text-gold { color: #fbbf24; }
  .text-purple { color: #c084fc; }
  .text-blue { color: #60a5fa; }
  .text-green { color: #34d399; }

  .kpi-progress-bar {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    overflow: hidden;
