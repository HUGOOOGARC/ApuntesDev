  }

  .btn-copy-uuid {
    background: none;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 2px;
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }

  .btn-copy-uuid:hover {
    color: #34d399;
  }

  /* OTHER CELLS */
  .lvl-badge {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid #334155;
    color: #fff;
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    font-weight: 800;
    font-size: 0.85rem;
    font-family: monospace;
  }

  .xp-cell {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .xp-value {
    font-weight: 800;
    font-family: monospace;
    font-size: 0.95rem;
  }

  .mult-chip {
    font-size: 0.7rem;
    color: #64748b;
    font-family: monospace;
  }

  .coins-value {
    color: #fbbf24;
    font-weight: 800;
    font-family: monospace;
    font-size: 0.95rem;
  }

  .prestige-cell {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .prestige-tag {
    color: #f59e0b;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .crystals-tag {
    color: #60a5fa;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .progress-cell {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 140px;
  }

  .progress-mini-bar {
    width: 100%;
    height: 5px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    overflow: hidden;
  }

  .progress-mini-fill {
    height: 100%;
    background: linear-gradient(90deg, #10b981, #06b6d4);
    border-radius: 6px;
  }

  .progress-ratio {
    font-size: 0.72rem;
    color: #94a3b8;
  }

  /* ACCIONES CLUSTER */
  .actions-cluster {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .btn-act {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-act:hover {
    transform: translateY(-1px);
  }

  .btn-xp:hover {
    background: rgba(16, 185, 129, 0.2);
    border-color: #10b981;
    color: #34d399;
  }

  .btn-coins:hover {
    background: rgba(245, 158, 11, 0.2);
    border-color: #f59e0b;
    color: #fbbf24;
  }

  .btn-lvl:hover {
    background: rgba(6, 182, 212, 0.2);
    border-color: #06b6d4;
    color: #22d3ee;
  }

  .btn-edit:hover {
    background: rgba(168, 85, 247, 0.2);
    border-color: #a855f7;
    color: #c084fc;
  }

  .loading-cell, .empty-state-cell {
    text-align: center;
    padding: 3.5rem !important;
    color: #64748b;
  }

  .admin-spinner {
    width: 28px;
    height: 28px;
    border: 3px solid rgba(16, 185, 129, 0.2);
    border-top-color: #10b981;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 0.75rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* 5. AUDIT TERMINAL SECTION */
  .audit-terminal-section {
    margin-top: 2rem;
  }

  .terminal-card {
    background: #090a0f;
    border: 1px solid #1e293b;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
  }

  .terminal-header {
    background: #0f131c;
    padding: 0.75rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #1e293b;
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .tdot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .tdot.red { background: #ef4444; }
  .tdot.yellow { background: #f59e0b; }
  .tdot.green { background: #10b981; }

  .terminal-title {
    font-size: 0.75rem;
    font-family: monospace;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 1px;
  }

  .terminal-actions {
    display: flex;
    gap: 0.5rem;
  }

  .btn-term-action {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid #334155;
    color: #94a3b8;
    font-size: 0.72rem;
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-term-action:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .terminal-screen {
    padding: 1.25rem;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    max-height: 220px;
    overflow-y: auto;
    color: #cbd5e1;
    background: #07090e;
  }

  .term-line {
    margin-bottom: 0.35rem;
    word-break: break-all;
  }

  .term-line.info { color: #38bdf8; }
  .term-line.success { color: #34d399; }
  .term-line.warn { color: #fbbf24; }
  .term-line.error { color: #f87171; }

  /* MODAL DE EDICIÓN */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 1.5rem;
  }

  .modal-dialog {
    background: #12151e;
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 16px;
    max-width: 520px;
    width: 100%;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
    overflow: hidden;
    animation: modalIn 0.25s ease;
  }

  @keyframes modalIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(20, 24, 34, 0.8);
  }

  .modal-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .modal-icon { font-size: 1.3rem; }

  .modal-header h3 {
    margin: 0;
    color: #fff;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .modal-sub {
    font-size: 0.72rem;
    color: #64748b;
    font-family: monospace;
  }

  .btn-close-modal {
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 1.2rem;
    cursor: pointer;
    transition: color 0.2s;
  }

  .btn-close-modal:hover { color: #fff; }

  .modal-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .form-group input {
    background: #090b10;
    border: 1px solid #334155;
    color: #fff;
    padding: 0.65rem 0.9rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-group input:focus {
    border-color: #10b981;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.2);
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.85rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid #334155;
    color: #cbd5e1;
    padding: 0.65rem 1.1rem;
    border-radius: 8px;
    font-weight: 600;
