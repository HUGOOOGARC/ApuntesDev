  }

  .kpi-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .kpi-title {
    color: #94a3b8;
    font-size: 0.82rem;
    font-weight: 700;
