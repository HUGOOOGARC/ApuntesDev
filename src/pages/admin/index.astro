  }

  .operator-email {
    color: #64748b;
    font-size: 0.75rem;
    font-family: monospace;
  }

  /* 2. KPI MATRIX / TELEMETRÍA */
  .telemetry-section {
    margin-bottom: 3rem;
  }

  .section-hdr {
