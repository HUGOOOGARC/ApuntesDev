---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SeccionApuntes from '../../components/SeccionApuntes.astro';

const todosLosApuntes = await getCollection('apuntes');

const apuntesRouting = todosLosApuntes.filter(a =>
  a.data.categoria === 'redes' && a.data.subcategoria === 'routing-switching' && !a.data.draft
);
const apuntesServicios = todosLosApuntes.filter(a =>
  a.data.categoria === 'redes' && a.data.subcategoria === 'servicios-red' && !a.data.draft
);

const totalApuntes = apuntesRouting.length + apuntesServicios.length;
---

<Layout
  title="Redes de Computadores — ApuntesDev"
  description="Apuntes de Routing & Switching, VLANs, direccionamiento IP y servicios de red como DNS, DHCP y seguridad."
>
  <Header />

  <SeccionApuntes
    icono="🌐"
    titulo="Redes de Computadores"
    descripcion="Configuración de routers, switches, VLANs, direccionamiento IP y servicios esenciales de red."
    color="redes"
    totalApuntes={totalApuntes}
    secciones={[
      {
        id: 'routing-switching',
        icono: '🔀',
        titulo: 'Routing & Switching',
        descripcion: 'VLANs, enrutamiento estático y dinámico, switches y direccionamiento IP.',
        apuntes: apuntesRouting,
        mensajeVacio: 'Pronto subiremos apuntes de Routing & Switching. ¡Vuelve en breve!',
      },
      {
        id: 'servicios-red',
        icono: '🛰️',
        titulo: 'Servicios de Red',
        descripcion: 'DNS, DHCP, servidores web, FTP, SSH y seguridad perimetral.',
        apuntes: apuntesServicios,
        mensajeVacio: 'Pronto subiremos apuntes de Servicios de Red. ¡Vuelve en breve!',
      },
    ]}
  />

  <Footer />
</Layout>
