---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DuelArena from '../components/arena/DuelArena.tsx';
---

<Layout
  title="Arena 1v1 • Duelos Técnicos a Contrarreloj | ApuntesDev"
  description="Enfréntate en combates de preguntas técnicas contra inteligencias y rivales. Demuestra tu velocidad y conocimientos de SMR y programación para ganar monedas, experiencia y prestigio."
>
  <Header />

  <main class="arena-page-layout">
    <!-- HERO DE LA ARENA -->
    <header class="arena-hero reveal">
      <div class="arena-hero-glow"></div>
      <div class="arena-hero-badge">
        <span class="pulse-spark"></span>
        <span>COLISEO CYBERPUNK // ENFRENTAMIENTOS EN VIVO</span>
        <span class="swords-icon">⚔️</span>
      </div>
      <h1 class="arena-main-title">
        Arena de <span class="gradient-text-fire">Combate 1v1</span>
      </h1>
      <p class="arena-main-subtitle">
        Pon a prueba tus reflejos y conocimientos técnicos bajo presión. 5 rondas a contrarreloj de 15 segundos para noquear a tu oponente y coronarte en el Salón de la Fama.
      </p>
    </header>

    <!-- COMPONENTE PRINCIPAL INTERACTIVO -->
    <section class="arena-interactive-section">
      <DuelArena client:load />
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* ==========================================================================
     ESTILOS ARENA DE COMBATE 1v1 (CYBER ARENA)
     ========================================================================== */
  .arena-page-layout {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
    position: relative;
    min-height: 85vh;
  }

  .arena-hero {
    text-align: center;
    margin-bottom: 2.5rem;
    position: relative;
    z-index: 1;
  }

  .arena-hero-glow {
    position: absolute;
    top: -40px;
    left: 50%;
    transform: translateX(-50%);
    width: 650px;
    height: 320px;
    background: radial-gradient(circle, rgba(244, 63, 94, 0.15) 0%, rgba(245, 158, 11, 0.05) 50%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  .arena-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(244, 63, 94, 0.12);
    border: 1px solid rgba(244, 63, 94, 0.35);
    color: #fb7185;
    padding: 0.35rem 0.95rem;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 1rem;
  }

  .pulse-spark {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f43f5e;
    box-shadow: 0 0 10px #f43f5e;
    animation: sparkPulse 1.2s infinite;
  }

  @keyframes sparkPulse {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.4); opacity: 1; }
  }

  .arena-main-title {
    font-size: 3rem;
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 0.75rem;
    letter-spacing: -0.03em;
  }

  .gradient-text-fire {
    background: linear-gradient(135deg, #f43f5e, #fbbf24);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .arena-main-subtitle {
    color: #94a3b8;
    font-size: 1.05rem;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* 1. ARENA LOBBY */
  .arena-lobby {
    background: rgba(18, 20, 28, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2.5rem 2rem;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(14px);
  }

  .arena-lobby-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .arena-tag {
    font-size: 0.75rem;
    font-family: monospace;
    font-weight: 800;
    color: #f43f5e;
    letter-spacing: 1px;
    display: block;
    margin-bottom: 0.5rem;
  }

  .arena-lobby-header h2 {
    color: #fff;
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
  }

  .arena-lobby-header p {
    color: #94a3b8;
    font-size: 0.95rem;
    margin: 0;
  }

  .rivals-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .rival-card {
    background: rgba(12, 14, 20, 0.8);
    border: 1px solid #2d3748;
    border-radius: 16px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .rival-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.7);
  }

  .rival-avatar-wrap {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 2px solid #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .bot-avatar {
    font-size: 2.5rem;
  }

  .diff-tag {
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.5px;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    display: inline-block;
    margin-bottom: 0.4rem;
  }

  .diff-tag.facil { background: rgba(52, 211, 153, 0.15); color: #34d399; }
  .diff-tag.medio { background: rgba(56, 189, 248, 0.15); color: #38bdf8; }
  .diff-tag.dificil { background: rgba(244, 63, 94, 0.15); color: #fb7185; }

  .rival-name {
    color: #fff;
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0 0 0.25rem;
  }

  .rival-alias {
    color: #94a3b8;
    font-size: 0.82rem;
    margin-bottom: 1.25rem;
    display: block;
  }

  .rival-specs {
    background: rgba(0, 0, 0, 0.35);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    width: 100%;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.8rem;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #94a3b8;
  }

  .spec-row strong {
    color: #fff;
    font-family: monospace;
  }

  .btn-challenge {
    width: 100%;
    border: none;
    color: #000;
    font-weight: 900;
    padding: 0.85rem 1.25rem;
    border-radius: 10px;
    cursor: pointer;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .btn-challenge:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 255, 255, 0.25);
    filter: brightness(1.15);
  }

  /* ARENA STATS FOOTER */
  .arena-stats-footer {
    display: flex;
    justify-content: space-around;
    background: rgba(0, 0, 0, 0.35);
    border-radius: 12px;
    padding: 1.25rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .arena-stat-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .arena-stat-box strong {
    font-size: 1.4rem;
    color: #fff;
    font-family: monospace;
  }

  .text-green { color: #34d399 !important; }
  .text-cyan { color: #38bdf8 !important; }
  .text-red { color: #f43f5e !important; }
  .text-gold { color: #fbbf24 !important; }

  /* 2. COMBATE EN VIVO */
  .battle-header-hud {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    background: rgba(18, 22, 32, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 1.25rem 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.7);
  }

  .fighter-card {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .fighter-card.bot {
    flex-direction: row-reverse;
  }

  .bot-align {
    text-align: right;
  }

  .fighter-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 2px solid #38bdf8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    flex-shrink: 0;
  }

  .fighter-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 140px;
  }

  .fighter-name {
    color: #fff;
    font-size: 0.95rem;
    font-weight: 800;
  }

  .hp-bar-wrap {
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    overflow: hidden;
  }

  .hp-bar-fill {
    height: 100%;
    transition: width 0.4s ease;
  }

  .hp-bar-fill.green { background: #10b981; box-shadow: 0 0 10px #10b981; }
  .hp-bar-fill.red { background: #ef4444; box-shadow: 0 0 10px #ef4444; }

  .points-label {
    font-size: 0.78rem;
    color: #94a3b8;
  }

  .points-label strong { color: #fff; font-family: monospace; }

  /* BATTLE DIAL */
  .battle-center-dial {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .round-pill {
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .countdown-circle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #0f131c;
    border: 3px solid #38bdf8;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.3);
    transition: all 0.2s;
  }

  .countdown-circle.critical {
    border-color: #ef4444;
    box-shadow: 0 0 20px rgba(239, 68, 68, 0.6);
    animation: criticalPulse 0.5s infinite alternate;
  }

  @keyframes criticalPulse {
    from { transform: scale(1); }
    to { transform: scale(1.08); }
  }

  .countdown-number {
    font-size: 1.4rem;
    font-weight: 900;
    color: #fff;
    font-family: monospace;
    line-height: 1;
  }

  .countdown-unit {
    font-size: 0.6rem;
    color: #64748b;
    text-transform: uppercase;
  }

  .vs-badge {
    font-size: 0.8rem;
    font-weight: 900;
    color: #f43f5e;
    letter-spacing: 1px;
  }

  /* PREGUNTA CENTRAL */
  .battle-question-card {
    background: rgba(18, 20, 28, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2.5rem 2rem;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
    text-align: center;
  }

  .question-category-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 1px;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  .battle-question-text {
    font-size: 1.45rem;
    font-weight: 800;
    color: #ffffff;
    max-width: 820px;
    margin: 0 auto 2rem;
    line-height: 1.5;
  }

  .battle-options-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    max-width: 840px;
    margin: 0 auto;
  }

  .battle-option-btn {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid #334155;
    color: #e2e8f0;
    padding: 1.1rem 1.25rem;
    border-radius: 12px;
    cursor: pointer;
    text-align: left;
    font-size: 0.95rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .battle-option-btn:hover:not(:disabled) {
    background: rgba(56, 189, 248, 0.15);
    border-color: #38bdf8;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(56, 189, 248, 0.2);
  }

  .battle-option-btn.correct {
    background: rgba(16, 185, 129, 0.2) !important;
    border-color: #10b981 !important;
    color: #34d399 !important;
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.3);
  }

  .battle-option-btn.wrong {
    background: rgba(239, 68, 68, 0.2) !important;
    border-color: #ef4444 !important;
    color: #f87171 !important;
  }

  .option-letter {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .battle-feedback-banner {
    margin-top: 1.75rem;
    padding: 0.85rem 1.25rem;
    border-radius: 10px;
    font-weight: 800;
    font-size: 0.95rem;
    animation: popFeedback 0.25s ease;
  }

  .battle-feedback-banner.good {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid #10b981;
    color: #34d399;
  }

  .battle-feedback-banner.bad {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid #ef4444;
    color: #f87171;
  }

  @keyframes popFeedback {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }

  /* 3. PANTALLA FINAL RESULTADO */
  .arena-result-card {
    background: rgba(18, 20, 28, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 3.5rem 2rem;
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(14px);
  }

  .result-icon-burst {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .result-title {
    font-size: 2rem;
    font-weight: 900;
    color: #fff;
    margin: 0 0 0.75rem;
  }

  .result-quote {
    color: #94a3b8;
    font-style: italic;
    font-size: 1rem;
    margin: 0 0 2rem;
  }

  .scoreboard-grid {
    display: flex;
    justify-content: space-around;
    align-items: center;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 14px;
    padding: 1.25rem;
    margin-bottom: 2rem;
  }

  .score-col {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .score-label {
    font-size: 0.75rem;
    color: #94a3b8;
    text-transform: uppercase;
    font-weight: 700;
  }

  .score-val {
    font-size: 1.6rem;
    font-weight: 900;
    font-family: monospace;
  }

  .vs-div {
    font-size: 1.1rem;
    font-weight: 900;
    color: #64748b;
  }

  .rewards-unlocked-card {
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 12px;
    padding: 1rem;
    margin-bottom: 2rem;
  }

  .rewards-unlocked-card h4 {
    margin: 0 0 0.5rem;
    color: #34d399;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .rewards-row {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-weight: 800;
    font-size: 1rem;
  }

  .result-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-arena-primary {
    background: linear-gradient(135deg, #f43f5e, #fbbf24);
    border: none;
    color: #000;
    font-weight: 900;
    padding: 0.9rem 1.75rem;
    border-radius: 12px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.2s ease;
  }

  .btn-arena-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(244, 63, 94, 0.4);
  }

  .btn-arena-secondary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid #334155;
    color: #cbd5e1;
    font-weight: 700;
    padding: 0.9rem 1.5rem;
    border-radius: 12px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.2s;
  }

  .btn-arena-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  @media (max-width: 768px) {
    .arena-main-title { font-size: 2.1rem; }
    .battle-header-hud { grid-template-columns: 1fr; gap: 1rem; text-align: center; }
    .fighter-card.bot { flex-direction: row; }
    .bot-align { text-align: left; }
    .battle-options-grid { grid-template-columns: 1fr; }
  }
</style>
