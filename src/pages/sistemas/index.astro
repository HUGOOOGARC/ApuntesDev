---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Importamos de forma recursiva todos los archivos .md dentro de som/ y sor/
const apuntesSOM = Object.values(import.meta.glob('./som/*.md', { eager: true }));
const apuntesSOR = Object.values(import.meta.glob('./sor/*.md', { eager: true }));
---

<Layout title="Sistemas Operativos - ApuntesDev">
  <Header />
  
  <section class="categoria-header">
    <h1>🖥️ Sistemas Informáticos (SMR)</h1>
    <p>Administración, comandos y configuración de sistemas operativos monopuestos y en red.</p>
  </section>

  <!-- ACCESOS RÁPIDOS A LAS SUBCARPETAS -->
  <div class="sub-nav-grid">
    <a href="/sistemas/som" class="sub-nav-card">
      <h3>🖥️ SOM</h3>
      <p>Sistemas Operativos Monopuestos</p>
    </a>
    <a href="/sistemas/sor" class="sub-nav-card">
      <h3>🌐 SOR</h3>
      <p>Sistemas Operativos en Red</p>
    </a>
  </div>

  <!-- SECCIÓN SOM -->
  <section class="seccion-bloque">
    <h2>📂 Apuntes de SOM (Monopuestos)</h2>
    <div class="lista-apuntes">
      {apuntesSOM.length > 0 ? (
        apuntesSOM.map((apunte: any) => (
          <article class="apunte-card">
            <h2><a href={apunte.url}>{apunte.frontmatter.title}</a></h2>
            <p>Categoría: SOM | 📅 {apunte.frontmatter.date || 'Reciente'}</p>
            <a href={apunte.url} class="leer-mas">Leer apunte →</a>
          </article>
        ))
      ) : (
        <p class="sin-apuntes">Próximamente subiremos apuntes de SOM...</p>
      )}
    </div>
  </section>

  <!-- SECCIÓN SOR -->
  <section class="seccion-bloque">
    <h2>📂 Apuntes de SOR (En Red)</h2>
    <div class="lista-apuntes">
      {apuntesSOR.length > 0 ? (
        apuntesSOR.map((apunte: any) => (
          <article class="apunte-card">
            <h2><a href={apunte.url}>{apunte.frontmatter.title}</a></h2>
            <p>Categoría: SOR | 📅 {apunte.frontmatter.date || 'Reciente'}</p>
            <a href={apunte.url} class="leer-mas">Leer apunte →</a>
          </article>
        ))
      ) : (
        <p class="sin-apuntes">Próximamente subiremos apuntes de SOR...</p>
      )}
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .categoria-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .categoria-header h1 {
    color: var(--accent-color);
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }
  .categoria-header p {
    color: #aaa;
  }

  /* Tarjetas de subnavegación SOM / SOR */
  .sub-nav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  .sub-nav-card {
    background: #181818;
    border: 1px solid #333;
    padding: 1.2rem;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    text-align: center;
    transition: all 0.2s ease;
  }
  .sub-nav-card:hover {
    border-color: var(--accent-color);
    transform: translateY(-3px);
  }
  .sub-nav-card h3 {
    margin: 0 0 0.4rem 0;
    color: #fff;
  }
  .sub-nav-card p {
    margin: 0;
    font-size: 0.85rem;
    color: #888;
  }

  .seccion-bloque {
    margin-bottom: 3rem;
  }
  .seccion-bloque h2 {
    color: #fff;
    font-size: 1.3rem;
    border-bottom: 1px solid #333;
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .lista-apuntes {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  
  .sin-apuntes {
    color: #666;
    font-style: italic;
    background: #151515;
    padding: 1rem;
    border-radius: 6px;
    border: 1px dashed #333;
    text-align: center;
  }
  
  /* Efecto Glow Hover */
  .apunte-card {
    background: #1e1e1e;
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid #333;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .apunte-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(76, 175, 80, 0.1), transparent);
    transition: left 0.5s ease;
  }
  .apunte-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-color);
    box-shadow: 0 8px 25px rgba(76, 175, 80, 0.15);
  }
  .apunte-card:hover::before {
    left: 100%;
  }
  .apunte-card h2 a {
    color: var(--text-color);
    text-decoration: none;
  }
  .apunte-card p {
    color: #aaa;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  .leer-mas {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: bold;
  }
</style>