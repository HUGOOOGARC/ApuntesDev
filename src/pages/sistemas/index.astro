---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SeccionApuntes from '../../components/SeccionApuntes.astro';

const todosLosApuntes = await getCollection('apuntes');

const apuntesSOM = todosLosApuntes.filter(a =>
  a.data.categoria === 'sistemas' && a.data.subcategoria === 'som' && !a.data.draft
);
const apuntesSOR = todosLosApuntes.filter(a =>
  a.data.categoria === 'sistemas' && a.data.subcategoria === 'sor' && !a.data.draft
);

const totalApuntes = apuntesSOM.length + apuntesSOR.length;
---

<Layout
  title="Sistemas Informáticos (SMR) — ApuntesDev"
  description="Apuntes de Sistemas Operativos Monopuestos (SOM) y en Red (SOR). Administración, virtualización y comandos de terminal."
>
  <Header />

  <SeccionApuntes
    icono="🖥️"
    titulo="Sistemas Informáticos"
    descripcion="Administración, virtualización, comandos de terminal y configuración de sistemas operativos monopuestos y en red."
    color="sistemas"
    totalApuntes={totalApuntes}
    secciones={[
      {
        id: 'som',
        icono: '💻',
        titulo: 'SOM — Sistemas Operativos Monopuestos',
        descripcion: 'Instalación, configuración y administración de sistemas operativos de escritorio.',
        apuntes: apuntesSOM,
        mensajeVacio: 'Pronto subiremos apuntes de SOM. ¡Vuelve en breve!',
      },
      {
        id: 'sor',
        icono: '🌐',
        titulo: 'SOR — Sistemas Operativos en Red',
        descripcion: 'Active Directory, gestión de usuarios, servidores y administración remota.',
        apuntes: apuntesSOR,
        mensajeVacio: 'Pronto subiremos apuntes de SOR. ¡Vuelve en breve!',
      },
    ]}
  />

  <Footer />
</Layout>
