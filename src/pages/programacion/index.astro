---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SeccionApuntes from '../../components/SeccionApuntes.astro';

const todosLosApuntes = await getCollection('apuntes');

const apuntesBackend = todosLosApuntes.filter(a =>
  a.data.categoria === 'programacion' && a.data.subcategoria === 'backend' && !a.data.draft
);
const apuntesFrontend = todosLosApuntes.filter(a =>
  a.data.categoria === 'programacion' && a.data.subcategoria === 'frontend' && !a.data.draft
);

const totalApuntes = apuntesBackend.length + apuntesFrontend.length;
---

<Layout
  title="Programación y Desarrollo — ApuntesDev"
  description="Apuntes de programación backend con Python y bases de datos, y frontend con HTML, CSS y JavaScript."
>
  <Header />

  <SeccionApuntes
    icono="💻"
    titulo="Programación y Desarrollo"
    descripcion="Aprende backend, frontend, algoritmos, estructuras de datos y construcción de aplicaciones modernas."
    color="programacion"
    totalApuntes={totalApuntes}
    secciones={[
      {
        id: 'backend',
        icono: '⚙️',
        titulo: 'Backend',
        descripcion: 'Python, lógica de servidor, bases de datos relacionales y APIs REST.',
        apuntes: apuntesBackend,
        mensajeVacio: 'Pronto subiremos apuntes de Backend. ¡Vuelve en breve!',
      },
      {
        id: 'frontend',
        icono: '🎨',
        titulo: 'Frontend',
        descripcion: 'HTML semántico, CSS moderno, JavaScript y frameworks web.',
        apuntes: apuntesFrontend,
        mensajeVacio: 'Pronto subiremos apuntes de Frontend. ¡Vuelve en breve!',
      },
    ]}
  />

  <Footer />
</Layout>
