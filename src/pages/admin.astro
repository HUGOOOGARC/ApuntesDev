---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Panel de Administración | ApuntesDev">
  <div class="admin-container">
    <div id="loading-screen" class="admin-card">
      <h2>Verificando permisos de acceso...</h2>
    </div>

    <div id="admin-content" style="display: none;">
      <h1>🛡️ Panel de Administración</h1>
      <p>Bienvenido al centro de control de ApuntesDev. Desde aquí podrás gestionar contenidos y supervisar la plataforma.</p>
      
      <div class="admin-grid">
        <div class="admin-card">
          <h3>Estadísticas de la plataforma</h3>
          <p>Control de usuarios registrados, XP global y monedas en circulación.</p>
        </div>
        <div class="admin-card">
          <h3>Gestión de Apuntes</h3>
          <p>Herramientas rápidas para validar o añadir nuevos temas de SMR.</p>
        </div>
      </div>
    </div>

    <div id="access-denied" style="display: none;" class="error-box">
      <h2>❌ Acceso Denegado</h2>
      <p>Esta zona está estrictamente restringida a administradores de ApuntesDev.</p>
      <a href="/" class="btn-volver">Volver al inicio</a>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  document.addEventListener('astro:page-load', async () => {
    const loadingScreen = document.getElementById('loading-screen');
    const adminContent = document.getElementById('admin-content');
    const accessDenied = document.getElementById('access-denied');

    // 1. Comprobamos si hay una sesión activa
    const { data: { session } } = await supabase.auth.getSession();
    
    if (!session) {
      window.location.href = '/login';
      return;
    }

    // 2. LISTA DE ADMINISTRADORES AUTORIZADOS
    const CORREOS_ADMINS = [
      'smr114.2026m@gmail.com',          // <--- Tu correo principal
      'hgarciaaltuzarra@gmail.com', // <--- Correo de otro admin (puedes añadir más)
    ];

    // Comprobamos si el correo del usuario actual está en la lista de admins
    const emailUsuario = session.user.email ?? '';
    const esAdmin = CORREOS_ADMINS.includes(emailUsuario);

    // Opcional por si prefieres consultar una columna de la base de datos:
    const { data: profile } = await supabase
      .from('profiles')
      .select('*')
      .eq('id', session.user.id)
      .single();

    const esAdminPorBD = profile?.is_admin === true;

    loadingScreen.style.display = 'none';

    if (esAdmin || esAdminPorBD) {
      adminContent.style.display = 'block';
    } else {
      accessDenied.style.display = 'block';
    }
  });
</script>

<style>
  .admin-container {
    max-width: 900px;
    margin: 3rem auto;
    padding: 0 1rem;
  }
  .admin-card {
    background: #111;
    border: 1px solid #333;
    padding: 2rem;
    border-radius: 12px;
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }
  h1 { color: var(--accent-color); margin-bottom: 0.5rem; }
  h2 { color: #fff; }
  p { color: #888; }
  .admin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .error-box {
    text-align: center;
    background: #1a0f0f;
    border: 1px solid #5a1a1a;
    padding: 3rem;
    border-radius: 12px;
  }
  .error-box h2 { color: #ff5252; margin-bottom: 1rem; }
  .btn-volver {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--accent-color);
    color: var(--bg-color);
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    transition: transform 0.2s;
  }
  .btn-volver:hover { transform: scale(1.05); }
</style>