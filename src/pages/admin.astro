---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Panel de Administración | ApuntesDev">
  <div class="admin-container">
    <div id="loading-screen" class="admin-card">
      <h2>Verificando permisos de acceso...</h2>
    </div>

    <div id="admin-content" style="display: none;">
      <h1>🛡️ Panel de Administración</h1>
      <p>Bienvenido al centro de control de ApuntesDev. Supervisión de usuarios y progreso global.</p>
      
      <div class="admin-card">
        <h3>👥 Estudiantes Registrados en la Plataforma</h3>
        <p class="subtitle">Lista sincronizada en tiempo real desde Supabase.</p>
        
        <div class="table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>ID de Usuario</th>
                <th>Nivel</th>
                <th>XP</th>
                <th>Monedas</th>
              </tr>
            </thead>
            <tbody id="tabla-usuarios-body">
              <!-- Los usuarios se inyectarán aquí mediante JavaScript -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div id="access-denied" style="display: none;" class="error-box">
      <h2>❌ Acceso Denegado</h2>
      <p>Esta zona está estrictamente restringida a administradores de ApuntesDev.</p>
      <a href="/" class="btn-volver">Volver al inicio</a>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  document.addEventListener('astro:page-load', async () => {
    const loadingScreen = document.getElementById('loading-screen');
    const adminContent = document.getElementById('admin-content');
    const accessDenied = document.getElementById('access-denied');

    const { data: { session } } = await supabase.auth.getSession();
    
    if (!session) {
      window.location.href = '/login';
      return;
    }

    // IMPRIME TU CORREO EN LA CONSOLA DEL NAVEGADOR (F12)
    console.log("Correo actual del usuario:", session.user.email);

    const CORREOS_ADMINS = [
      'hgarciaaltuzarra@gmail.com',
      // Añade aquí también el correo exacto con el que entras si es diferente (ej. de Google o GitHub)
    ];

    const emailUsuario = session.user.email ?? '';
    const esAdmin = CORREOS_ADMINS.includes(emailUsuario);

    const { data: profile } = await supabase
      .from('profiles')
      .select('*')
      .eq('id', session.user.id)
      .single();

    const esAdminPorBD = profile?.is_admin === true;

    loadingScreen.style.display = 'none';

    if (esAdmin || esAdminPorBD) {
      adminContent.style.display = 'block';
      // ... (código de la tabla de usuarios)
    } else {
      accessDenied.style.display = 'block';
    }
  });
</script>

<style>
  .admin-container {
    max-width: 1000px;
    margin: 3rem auto;
    padding: 0 1rem;
  }
  .admin-card {
    background: #111;
    border: 1px solid #333;
    padding: 2rem;
    border-radius: 12px;
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }
  h1 { color: var(--accent-color); margin-bottom: 0.5rem; }
  h2 { color: #fff; }
  p { color: #888; }
  .subtitle { font-size: 0.9rem; margin-bottom: 1.5rem; }

  /* Estilos de la Tabla */
  .table-responsive {
    overflow-x: auto;
  }
  .admin-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-family: inherit;
  }
  .admin-table th, .admin-table td {
    padding: 1rem;
    border-bottom: 1px solid #222;
  }
  .admin-table th {
    color: var(--accent-color);
    font-weight: bold;
    border-bottom: 2px solid #333;
  }
  .admin-table tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }
  .user-id {
    font-family: monospace;
    color: #888;
    font-size: 0.9rem;
  }
  .badge-nivel {
    background: var(--accent-color);
    color: var(--bg-color);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: bold;
    font-size: 0.85rem;
  }
  .coins {
    color: #FFD700;
    font-weight: bold;
  }

  .error-box {
    text-align: center;
    background: #1a0f0f;
    border: 1px solid #5a1a1a;
    padding: 3rem;
    border-radius: 12px;
  }
  .error-box h2 { color: #ff5252; margin-bottom: 1rem; }
  .btn-volver {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--accent-color);
    color: var(--bg-color);
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    transition: transform 0.2s;
  }
  .btn-volver:hover { transform: scale(1.05); }
</style>