---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="ApuntesDev | Domina SMR, Redes y Programación">
  <Header />

  <!-- HERO SECTION A PANTALLA COMPLETA CON AMBIENTE CYBERPUNK -->
  <section class="hero-viewport">
    
    <!-- Luces de Fondo y Grid Cibernético -->
    <div class="ambient-grid"></div>
    <div class="glow-orb glow-orb--emerald"></div>
    <div class="glow-orb glow-orb--cyan"></div>
    <div class="glow-orb glow-orb--purple"></div>

    <div class="hero-wrapper">
      
      <!-- Pill Badge Animada -->
      <div class="hero-badge-container">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span class="badge-text">SMR & CIBERSEGURIDAD • GAMIFICACIÓN REAL</span>
          <span class="badge-arrow">✨</span>
        </div>
      </div>

      <!-- Título Principal de Impacto -->
      <h1 class="hero-title">
        Sube de nivel en <br />
        <span class="hero-gradient-text">SMR y Código</span>
      </h1>

      <!-- Subtítulo -->
      <p class="hero-subtitle">
        Domina <strong>Sistemas Operativos</strong>, <strong>Redes de Computadores</strong> y <strong>Programación</strong>. Completa lecciones sintetizadas, acumula XP, gana créditos y desbloquea temas de terminal exclusivos.
      </p>

      <!-- Botones de Acción Épicos -->
      <div class="hero-actions">
        <a href="/sistemas" class="btn-hero-primary">
          <span>Empezar a Estudiar</span>
          <svg class="btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>

        <a href="/perfil" class="btn-hero-secondary">
          <span>Ver mi Rango & Stats</span>
          <span class="btn-emoji">👤</span>
        </a>
      </div>

      <!-- Hint de Consola Rápida -->
      <div class="hero-hint">
        <span>Tip Pro: Pulsa <kbd>Ctrl</kbd> + <kbd>K</kbd> en cualquier momento para abrir la consola rápida</span>
      </div>

      <!-- TERMINAL SHOWCASE CIBERNÉTICA -->
      <div class="terminal-showcase">
        <div class="terminal-bar">
          <div class="terminal-dots">
            <span class="dot dot--red"></span>
            <span class="dot dot--yellow"></span>
            <span class="dot dot--green"></span>
          </div>
          <div class="terminal-title">apuntesdev@cloud: ~/learning-hub/2026</div>
          <div class="terminal-status">
            <span class="status-indicator"></span> ONLINE
          </div>
        </div>

        <div class="terminal-body">
          <div class="terminal-grid">
            <div class="terminal-stat">
              <span class="term-stat-num">50 XP</span>
              <span class="term-stat-label">Recompensa por apunte</span>
            </div>
            <div class="terminal-stat">
              <span class="term-stat-num">10 🪙</span>
              <span class="term-stat-label">Créditos de tienda</span>
            </div>
            <div class="terminal-stat">
              <span class="term-stat-num">3 Rutas</span>
              <span class="term-stat-label">Sistemas • Redes • Dev</span>
            </div>
            <div class="terminal-stat">
              <span class="term-stat-num">4 Temas</span>
              <span class="term-stat-label">Kali • Dracula • Matrix</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- SECCIÓN DE CARACTERÍSTICAS BENTO GRID 2.0 -->
  <section class="section-full features-section">
    <div class="content-container">
      
      <div class="section-header">
        <span class="section-tag">¿POR QUÉ APUNTESDEV?</span>
        <h2 class="section-title">Aprender informática ya no es aburrido</h2>
        <p class="section-desc">Diseñado para que domines los conceptos teóricos y prácticos de SMR mientras progresas en tu partida.</p>
      </div>

      <div class="bento-features">
        
        <!-- CARD 1: Directo al Grano -->
        <div class="feature-tile">
          <div class="tile-icon-bg">⚡</div>
          <h3>Directo al Grano</h3>
          <p>Apuntes sintetizados en Markdown listos para estudiar. Menos relleno y más comandos, arquitecturas y configuraciones reales.</p>
          <div class="tile-tag">100% Práctico</div>
        </div>

        <!-- CARD 2: Gamificación -->
        <div class="feature-tile feature-tile--highlight">
          <div class="tile-icon-bg">🎮</div>
          <h3>Gamificación Real</h3>
          <p>Gana 50 XP y 10 monedas por cada apunte dominado. Sube de rango, alcanza el Nivel 50 y desbloquea el Protocolo de Prestigio.</p>
          <div class="tile-tag">Sube de Nivel</div>
        </div>

        <!-- CARD 3: Redes & Cisco -->
        <div class="feature-tile">
          <div class="tile-icon-bg">🌐</div>
          <h3>Redes & Laboratorios</h3>
          <p>Subnetting IPv4/IPv6 con VLSM, VLANs 802.1Q en Cisco IOS, servidores DNS y DHCP en Linux para simulaciones Packet Tracer.</p>
          <div class="tile-tag">Cisco & Linux</div>
        </div>

        <!-- CARD 4: Tienda de Temas -->
        <div class="feature-tile">
          <div class="tile-icon-bg">🎨</div>
          <h3>Tienda de Temas Visuales</h3>
          <p>Invierte tus créditos en desbloquear skins completas para la web: Kali Linux rojo fuego, Matrix verde fósforo o Cyberpunk neón.</p>
          <div class="tile-tag">Endgame Store</div>
        </div>

        <!-- CARD 5: Leaderboard -->
        <div class="feature-tile">
          <div class="tile-icon-bg">🏆</div>
          <h3>Leaderboard Global</h3>
          <p>Compite sanamente contra tus compañeros de clase. Mira quién ha acumulado más experiencia y quién lidera el Hall of Fame.</p>
          <div class="tile-tag">Top Operadores</div>
        </div>

        <!-- CARD 6: Buscador Instantáneo -->
        <div class="feature-tile">
          <div class="tile-icon-bg">🔍</div>
          <h3>Búsqueda Rápida (Ctrl+K)</h3>
          <p>Encuentra cualquier comando, servicio o sintaxis en milisegundos con nuestra paleta de comandos flotante integrada.</p>
          <div class="tile-tag">Acceso Ultra Rápido</div>
        </div>

      </div>

    </div>
  </section>

  <!-- RUTAS DE APRENDIZAJE EXPANDIDAS -->
  <section class="section-full rutas-section">
    <div class="content-container">
      
      <div class="section-header">
        <span class="section-tag">RUTAS TRONCALES</span>
        <h2 class="section-title">Elige tu camino de especialización</h2>
        <p class="section-desc">Selecciona el módulo en el que quieres entrenar hoy y comienza a sumar puntos de experiencia.</p>
      </div>

      <div class="rutas-grid">
        
        <!-- RUTA 1: SISTEMAS -->
        <a href="/sistemas" class="ruta-card ruta-card--sistemas">
          <div class="ruta-card-glow"></div>
          <div class="ruta-card-header">
            <span class="ruta-badge">SOM / SOR</span>
            <span class="ruta-xp">+50 XP / apunte</span>
          </div>
          <div class="ruta-card-icon">🖥️</div>
          <h3>Sistemas Informáticos</h3>
          <p>Linux terminal, administración de usuarios, Active Directory, permisos de archivos, scripts Bash y virtualización.</p>
          <div class="ruta-card-footer">
            <span>Explorar Sistemas</span>
            <span class="arrow-move">→</span>
          </div>
        </a>

        <!-- RUTA 2: REDES -->
        <a href="/redes" class="ruta-card ruta-card--redes">
          <div class="ruta-card-glow"></div>
          <div class="ruta-card-header">
            <span class="ruta-badge">TELECOM & CISCO</span>
            <span class="ruta-xp">+50 XP / apunte</span>
          </div>
          <div class="ruta-card-icon">🌐</div>
          <h3>Redes de Computadores</h3>
          <p>Subnetting con VLSM, enlaces troncales VLAN 802.1Q en switches Cisco, servidores DHCP y resolución BIND9.</p>
          <div class="ruta-card-footer">
            <span>Explorar Redes</span>
            <span class="arrow-move">→</span>
          </div>
        </a>

        <!-- RUTA 3: PROGRAMACIÓN -->
        <a href="/programacion" class="ruta-card ruta-card--prog">
          <div class="ruta-card-glow"></div>
          <div class="ruta-card-header">
            <span class="ruta-badge">DEV & BACKEND</span>
            <span class="ruta-xp">+50 XP / apunte</span>
          </div>
          <div class="ruta-card-icon">💻</div>
          <h3>Programación & Web</h3>
          <p>Lógica de programación con Python, estructuras de control, bases de datos SQL y desarrollo web moderno.</p>
          <div class="ruta-card-footer">
            <span>Explorar Programación</span>
            <span class="arrow-move">→</span>
          </div>
        </a>

      </div>

    </div>
  </section>

  <!-- CTA FINAL AURORA -->
  <section class="section-full cta-section">
    <div class="content-container">
      <div class="cta-aurora-box">
        <div class="cta-aurora-bg"></div>
        <div class="cta-content">
          <span class="cta-pill">🚀 COMIENZA AHORA MISMO</span>
          <h2>¿Listo para subir de nivel tu carrera técnica?</h2>
          <p>Crea tu cuenta gratuita en menos de 30 segundos, sincroniza tu progreso en la nube y compite con la comunidad.</p>
          <div class="cta-btns">
            <a href="/login" class="btn-hero-primary">
              <span>Crear Cuenta Gratis</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
            <a href="/sistemas" class="btn-hero-secondary">
              <span>Explorar sin Registro →</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ==========================================================================
     HERO SECTION A PANTALLA COMPLETA CON LUCES AMBIENTALES
     ========================================================================== */
  .hero-viewport {
    width: 100%;
    min-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 5rem 2rem 4rem;
    overflow: hidden;
  }

  /* Grid cibernético de fondo */
  .ambient-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 80% 65% at 50% 25%, #000 20%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 80% 65% at 50% 25%, #000 20%, transparent 85%);
    pointer-events: none;
    z-index: 0;
  }

  /* Esferas de luz ambiental flotantes */
  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
    opacity: 0.6;
    animation: orbFloat 10s ease-in-out infinite alternate;
  }

  .glow-orb--emerald {
    width: 650px;
    height: 380px;
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(74, 222, 128, 0.22) 0%, transparent 70%);
  }

  .glow-orb--cyan {
    width: 500px;
    height: 300px;
    top: 25%;
    left: 20%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.16) 0%, transparent 70%);
    animation-delay: -3s;
  }

  .glow-orb--purple {
    width: 550px;
    height: 320px;
    top: 30%;
    right: 20%;
    background: radial-gradient(circle, rgba(167, 139, 250, 0.14) 0%, transparent 70%);
    animation-delay: -6s;
  }

  @keyframes orbFloat {
    0% { transform: translate(-50%, 0) scale(1); }
    50% { transform: translate(-48%, -25px) scale(1.08); }
    100% { transform: translate(-52%, 20px) scale(0.96); }
  }

  /* Contenedor central del Hero */
  .hero-wrapper {
    position: relative;
    z-index: 1;
    max-width: 1040px;
    width: 100%;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Badge Pill con pulso */
  .hero-badge-container {
    margin-bottom: 1.75rem;
    animation: fadeInDown 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: linear-gradient(135deg, rgba(74, 222, 128, 0.1), rgba(56, 189, 248, 0.06));
    border: 1px solid rgba(74, 222, 128, 0.3);
    padding: 0.45rem 1.25rem;
    border-radius: 100px;
    box-shadow: 0 0 25px rgba(74, 222, 128, 0.15);
    backdrop-filter: blur(16px);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .hero-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 35px rgba(74, 222, 128, 0.3);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--accent-color);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent-color);
    animation: pulseDot 2s infinite;
  }

  .badge-text {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-color);
    font-family: var(--font-mono);
  }

  .badge-arrow {
    font-size: 0.85rem;
  }

  /* Título Principal */
  .hero-title {
    font-size: clamp(3rem, 7vw, 5.2rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin: 0 0 1.5rem;
    color: #ffffff;
    animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-gradient-text {
    background: linear-gradient(135deg, #ffffff 10%, #4ade80 50%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 45px rgba(74, 222, 128, 0.4));
  }

  /* Subtítulo */
  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: #94a3b8;
    max-width: 720px;
    line-height: 1.7;
    margin: 0 0 2.5rem;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-subtitle strong {
    color: #f1f5f9;
  }

  /* Botones del Hero */
  .hero-actions {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    animation: fadeInUp 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-hero-primary {
    background: linear-gradient(135deg, var(--accent-color) 0%, var(--accent-dark) 100%);
    color: #060809;
    padding: 1rem 2.2rem;
    border-radius: 14px;
    font-size: 1.05rem;
    font-weight: 800;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    box-shadow: 0 10px 30px rgba(74, 222, 128, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  /* Reflejo de luz que pasa por el botón */
  .btn-hero-primary::after {
    content: '';
    position: absolute;
    top: 0;
    left: -120%;
    width: 80%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
    transform: skewX(-25deg);
    transition: left 0.75s ease;
  }

  .btn-hero-primary:hover::after {
    left: 150%;
  }

  .btn-hero-primary:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 15px 45px rgba(74, 222, 128, 0.55);
  }

  .btn-icon {
    transition: transform 0.25s ease;
  }

  .btn-hero-primary:hover .btn-icon {
    transform: translateX(4px);
  }

  .btn-hero-secondary {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #f1f5f9;
    padding: 1rem 2.2rem;
    border-radius: 14px;
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    backdrop-filter: blur(16px);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-hero-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(74, 222, 128, 0.4);
    transform: translateY(-3px);
    color: var(--accent-color);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  /* Hint de consola */
  .hero-hint {
    font-size: 0.82rem;
    color: #64748b;
    margin-bottom: 3.5rem;
  }

  .hero-hint kbd {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #94a3b8;
    padding: 0.15rem 0.45rem;
    border-radius: 5px;
    font-family: var(--font-mono);
    font-weight: 700;
  }

  /* ── TERMINAL SHOWCASE CARD ── */
  .terminal-showcase {
    width: 100%;
    max-width: 880px;
    background: rgba(13, 15, 22, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    backdrop-filter: blur(24px);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(74, 222, 128, 0.08);
    overflow: hidden;
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .terminal-showcase:hover {
    border-color: rgba(74, 222, 128, 0.3);
    transform: translateY(-4px);
  }

  .terminal-bar {
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .terminal-dots {
    display: flex;
    gap: 7px;
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .dot--red { background: #ff5f56; }
  .dot--yellow { background: #ffbd2e; }
  .dot--green { background: #27c93f; }

  .terminal-title {
    font-size: 0.8rem;
    color: #64748b;
    font-family: var(--font-mono);
  }

  .terminal-status {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--accent-color);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    background: var(--accent-color);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--accent-color);
  }

  .terminal-body {
    padding: 1.75rem 2rem;
  }

  .terminal-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .terminal-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .term-stat-num {
    font-size: 1.5rem;
    font-weight: 900;
    color: #ffffff;
    font-family: var(--font-mono);
    letter-spacing: -0.02em;
  }

  .term-stat-label {
    font-size: 0.72rem;
    color: #64748b;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  /* ==========================================================================
     SECCIÓN DE CARACTERÍSTICAS (BENTO GRID 2.0)
     ========================================================================== */
  .section-full {
    width: 100%;
    padding: 6.5rem 2rem;
    position: relative;
  }

  .content-container {
    max-width: 1560px;
    width: 100%;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-tag {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    font-weight: 800;
    color: var(--accent-color);
    letter-spacing: 0.15em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }

  .section-desc {
    color: #94a3b8;
    font-size: 1.1rem;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .bento-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .feature-tile {
    background: linear-gradient(145deg, rgba(20, 22, 32, 0.7) 0%, rgba(13, 15, 22, 0.85) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 2.5rem 2.2rem;
    backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .feature-tile::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-color), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .feature-tile:hover {
    transform: translateY(-8px);
    border-color: rgba(74, 222, 128, 0.4);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6), 0 0 30px rgba(74, 222, 128, 0.12);
  }

  .feature-tile:hover::before {
    opacity: 1;
  }

  .feature-tile--highlight {
    background: linear-gradient(145deg, rgba(25, 35, 30, 0.8) 0%, rgba(13, 18, 16, 0.9) 100%);
    border-color: rgba(74, 222, 128, 0.25);
  }

  .tile-icon-bg {
    font-size: 2.5rem;
    line-height: 1;
    margin-bottom: 1.5rem;
