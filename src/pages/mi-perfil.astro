---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Centro de Mando - ApuntesDev">
  <Header />

  <section class="dashboard-header">
    <div class="header-glow"></div>
    <h1>Centro de Mando</h1>
    <p>Monitorización global de progreso, estadísticas de estudio y arsenal de conocimientos.</p>
  </section>

  <!-- BENTO GRID SYSTEM -->
  <div class="bento-grid" id="bento-dashboard">
    <!-- Se llenará dinámicamente con JS al cargar el perfil de Zustand -->
    <div class="cargando-perfil">Sincronizando con los servidores...</div>
  </div>

  <Footer />
</Layout>

<script>
  import { perfilStore, obtenerEstadisticasNivel } from '../store/progreso';

  document.addEventListener('astro:page-load', () => {
    const contenedor = document.getElementById('bento-dashboard');
    if (!contenedor) return;

    // Suscribirnos a los cambios del perfil para que reaccione en tiempo real
    const unsubscribe = perfilStore.subscribe((perfil) => {
      // 1. Cálculos matemáticos usando tu función calcularXpNecesaria
      const stats = obtenerEstadisticasNivel(perfil.nivel, perfil.xp);
      
      // 2. Cálculos temporales de estadísticas por categoría
      const totalApuntes = perfil.apuntesCompletados ? perfil.apuntesCompletados.length : 0;
      
      // Contar apuntes por prefijo de ID (som-, sor-, python-, etc.)
      const countSom = perfil.apuntesCompletados.filter(id => id.includes('som') || id.includes('sor')).length;
      const countProg = perfil.apuntesCompletados.filter(id => id.includes('python') || id.includes('backend') || id.includes('frontend')).length;
      const countRedes = perfil.apuntesCompletados.filter(id => id.includes('redes') || id.includes('routing')).length;

      // Porcentajes visuales para el radar (máximo 100%)
      const statsSistemas = Math.min((countSom * 20), 100);
      const statsProg = Math.min((countProg * 20), 100);
      const statsRedes = Math.min((countRedes * 20), 100);

      // 3. Renderizar el Bento Grid
      contenedor.innerHTML = `
        <!-- CARD 1: IDENTIDAD Y PROGRESO -->
        <article class="bento-card bento-wide">
          <div class="perfil-header">
            <div class="avatar-box">
              <span class="avatar-emoji">👨‍💻</span>
            </div>
            <div class="perfil-info">
              <h2>Operador SMR</h2>
              <div class="nivel-badge">
                Nivel ${perfil.nivel} 
                ${perfil.prestigio > 0 ? `<span class="prestigio-star">⭐ x${perfil.prestigio}</span>` : ''}
              </div>
            </div>
          </div>
          
          <div class="progreso-container">
            <div class="progreso-stats">
              <span>Progreso de Nivel ${perfil.nivel}</span>
              <span>${stats.xpEnEsteNivel} / ${stats.xpRequerida} XP</span>
            </div>
            <div class="barra-fondo">
              <div class="barra-relleno" style="width: ${stats.porcentaje}%"></div>
            </div>
          </div>
        </article>

        <!-- CARD 2: BÓVEDA FINANCIERA -->
        <article class="bento-card bento-square vault-card">
          <h3>Bóveda de Créditos</h3>
          <div class="monedas-display">
            <span class="moneda-icon">🪙</span>
            <span class="moneda-valor">${perfil.monedas}</span>
          </div>
          <p class="vault-desc">Acumula créditos completando apuntes para desbloquear temas y skins en la tienda.</p>
        </article>

        <!-- CARD 3: RADAR DE HABILIDADES -->
        <article class="bento-card bento-square">
          <h3>Radar de Habilidades</h3>
          
          <div class="skill-row">
            <div class="skill-label">Sistemas (SOM/SOR)</div>
            <div class="skill-barra-fondo">
              <div class="skill-barra-relleno" style="width: ${statsSistemas}%; background: #4CAF50;"></div>
            </div>
          </div>
          
          <div class="skill-row">
            <div class="skill-label">Programación</div>
            <div class="skill-barra-fondo">
              <div class="skill-barra-relleno" style="width: ${statsProg}%; background: #2196F3;"></div>
            </div>
          </div>

          <div class="skill-row">
            <div class="skill-label">Redes & Ciber</div>
            <div class="skill-barra-fondo">
              <div class="skill-barra-relleno" style="width: ${statsRedes}%; background: #FF9800;"></div>
            </div>
          </div>
        </article>

        <!-- CARD 4: VITRINA DE LOGROS (GLASSMORPHISM) -->
        <article class="bento-card bento-wide logros-card">
          <h3>Vitrina de Logros</h3>
          <div class="logros-grid">
            <div class="logro-item ${totalApuntes >= 1 ? 'unlocked' : ''}">
              <div class="logro-icon">🚀</div>
              <h4>Primeros Pasos</h4>
              <p>Completa tu primer apunte.</p>
            </div>
            <div class="logro-item ${perfil.nivel >= 5 ? 'unlocked' : ''}">
              <div class="logro-icon">⚡</div>
              <h4>Operador Nivel 5</h4>
              <p>Alcanza el nivel 5 de experiencia.</p>
            </div>
            <div class="logro-item ${totalApuntes >= 10 ? 'unlocked' : ''}">
              <div class="logro-icon">🧠</div>
              <h4>Cerebro Máquina</h4>
              <p>Domina 10 apuntes en total.</p>
            </div>
            <div class="logro-item ${perfil.prestigio > 0 ? 'unlocked' : ''}">
              <div class="logro-icon">👑</div>
              <h4>Prestigio I</h4>
              <p>Alcanza el nivel máximo y renace.</p>
            </div>
          </div>
        </article>
      `;
    });

    // Disparar la primera carga del perfil
    const perfilActual = perfilStore.get();
    if (perfilActual) {
      perfilStore.set(perfilActual); 
    }
  });
</script>

<style>
  /* CABECERA DEL DASHBOARD */
  .dashboard-header {
    text-align: center;
    margin-bottom: 3rem;
    position: relative;
    padding-top: 2rem;
  }
  .header-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 300px;
    height: 150px;
    background: radial-gradient(circle, rgba(76, 175, 80, 0.15) 0%, transparent 70%);
    z-index: -1;
  }
  .dashboard-header h1 {
    color: var(--accent-color);
    font-size: 3rem;
    margin-bottom: 0.5rem;
    letter-spacing: -1px;
    text-transform: uppercase;
  }
  .dashboard-header p {
    color: #888;
    font-size: 1.1rem;
  }

  /* BENTO GRID (Arquitectura de Cuadrícula Pro) */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto 4rem auto;
  }

  @media (max-width: 768px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
  }

  .bento-card {
    background: rgba(20, 20, 20, 0.6);
    border: 1px solid #333;
    border-radius: 16px;
    padding: 2rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .bento-card:hover {
    border-color: rgba(76, 175, 80, 0.5);
    transform: translateY(-2px);
  }

  .bento-wide { grid-column: 1 / -1; }
  .bento-square { display: flex; flex-direction: column; }

  /* CARD 1: PERFIL Y PROGRESO */
  .perfil-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .avatar-box {
    width: 80px;
    height: 80px;
    background: #111;
    border: 2px solid var(--accent-color);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    box-shadow: 0 0 20px rgba(76, 175, 80, 0.2);
  }
  .perfil-info h2 { margin: 0 0 0.5rem 0; font-size: 1.8rem; color: #fff; }
  .nivel-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent-color);
    color: #000;
    padding: 0.3rem 0.8rem;
    border-radius: 6px;
    font-weight: bold;
    font-size: 0.9rem;
  }
  .prestigio-star { color: #fff; text-shadow: 0 0 5px rgba(255, 255, 255, 0.8); }
  
  /* Sistema de Barras y Stats Generales */
  .progreso-stats {
    display: flex;
    justify-content: space-between;
    color: #aaa;
    font-size: 0.9rem;
    font-weight: bold;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .barra-fondo {
    width: 100%;
    height: 16px;
    background: #111;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: inset 0 2px 5px rgba(0,0,0,0.5);
    border: 1px solid #222;
  }
  .barra-relleno {
    height: 100%;
    background: linear-gradient(90deg, #4CAF50, #81C784);
    border-radius: 8px;
    transition: width 1s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 0 15px rgba(76, 175, 80, 0.4);
  }

  /* CARD 2: BÓVEDA FINANCIERA */
  .vault-card { text-align: center; justify-content: center; }
  .vault-card h3 { color: #888; font-size: 1rem; text-transform: uppercase; margin-top: 0; }
  .monedas-display {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    margin: 1.5rem 0;
  }
  .moneda-icon { font-size: 3rem; filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.3)); }
  .moneda-valor { font-size: 3.5rem; font-family: monospace; font-weight: bold; color: #fff; line-height: 1; }
  .vault-desc { color: #666; font-size: 0.85rem; margin: 0; line-height: 1.5; }

  /* CARD 3: RADAR DE HABILIDADES */
  .skill-row { margin-bottom: 1.2rem; }
  .skill-row:last-child { margin-bottom: 0; }
  .skill-label { font-size: 0.85rem; color: #ccc; margin-bottom: 0.4rem; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px; }
  .skill-barra-fondo { width: 100%; height: 8px; background: #1a1a1a; border-radius: 4px; overflow: hidden; border: 1px solid #222; }
  .skill-barra-relleno { height: 100%; border-radius: 4px; transition: width 1s ease-out; box-shadow: inset 0 0 5px rgba(255, 255, 255, 0.2); }

  /* CARD 4: LOGROS GLASSMORPHISM */
  .logros-card h3 { color: #888; font-size: 1rem; text-transform: uppercase; margin-top: 0; margin-bottom: 1.5rem; }
  .logros-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .logro-item {
    background: rgba(0, 0, 0, 0.4);
    border: 1px dashed #333;
    padding: 1.5rem 1rem;
    border-radius: 12px;
    text-align: center;
    opacity: 0.5;
    filter: grayscale(100%);
    transition: all 0.3s ease;
  }
  .logro-item.unlocked {
    opacity: 1;
    filter: grayscale(0%);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(76, 175, 80, 0.3);
    box-shadow: 0 4px 15px rgba(76, 175, 80, 0.05);
  }
  .logro-icon { font-size: 2rem; margin-bottom: 0.8rem; }
  .logro-item h4 { color: #fff; margin: 0 0 0.3rem 0; font-size: 0.95rem; }
  .logro-item p { color: #666; font-size: 0.75rem; margin: 0; line-height: 1.4; }
  
  .cargando-perfil { text-align: center; color: #666; padding: 3rem; font-style: italic; }
</style>