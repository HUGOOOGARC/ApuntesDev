---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotonCompletar from '../components/BotonCompletar.tsx';

const { frontmatter, headings } = Astro.props;
const indice = headings ? headings.filter((h: any) => h.depth === 2 || h.depth === 3) : [];
---

<!-- Aquí inyectamos el título y la descripción específicos del Markdown para el SEO -->
<Layout 
  title={`${frontmatter.title} | ApuntesDev`} 
  description={frontmatter.description || "Apunte de SMR para dominar este concepto y ganar XP."}
>
  <Header />
  
  <div class="progreso-contenedor">
    <div class="progreso-barra" id="barra-lectura"></div>
  </div>

  <div class="layout-apunte">
    <aside class="sidebar-indice">
      <div class="indice-sticky">
        <h3>En este apunte</h3>
        <ul>
          {indice.map((heading: any) => (
            <li class={`nivel-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <article class="apunte-contenido">
      <header class="apunte-cabecera">
        <h1>{frontmatter.title}</h1>
        <p class="fecha">Publicado el: {frontmatter.date}</p>
        <span class="etiqueta">{frontmatter.category}</span>
      </header>

      <div class="contenido-markdown">
        <slot />
      </div>
      <div class="zona-recompensa">
        <BotonCompletar client:visible idApunte={Astro.url.pathname} />
      </div>
    </article>
  </div>

  <Footer />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    // 1. LÓGICA DE LA BARRA DE LECTURA (Mantén lo que ya tenías)
    const barra = document.getElementById('barra-lectura');
    if (barra) {
      const actualizarProgreso = () => {
        const alturaTotal = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrollActual = document.documentElement.scrollTop;
        const porcentaje = (scrollActual / alturaTotal) * 100;
        barra.style.width = porcentaje + '%';
      };
      window.addEventListener('scroll', actualizarProgreso);
      actualizarProgreso();
    }

    // 2. NUEVA LÓGICA: BOTÓN DE COPIAR EN CÓDIGO
    const bloquesCodigo = document.querySelectorAll('.contenido-markdown pre');
    
    bloquesCodigo.forEach((bloque) => {
      // Evitamos duplicados si el botón ya existe
      if (bloque.querySelector('.copy-btn')) return;

      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.textContent = 'Copiar';

      btn.addEventListener('click', async () => {
        // Buscamos el texto dentro de la etiqueta <code>
        const codigo = bloque.querySelector('code')?.innerText || '';
        await navigator.clipboard.writeText(codigo);
        
        // Feedback visual
        btn.textContent = '¡Copiado! ✅';
        btn.style.color = 'var(--bg-color)';
        btn.style.background = 'var(--accent-color)';
        
        setTimeout(() => {
          btn.textContent = 'Copiar';
          btn.style.color = '';
          btn.style.background = '';
        }, 2000);
      });

      bloque.appendChild(btn);
    });
  });
</script>

<style is:global>
  .progreso-contenedor {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background-color: transparent;
    z-index: 9999;
  }
  .progreso-barra {
    height: 100%;
    background-color: var(--accent-color);
    width: 0%;
    transition: width 0.1s ease-out;
    box-shadow: 0 0 10px var(--accent-color);
  }

  .layout-apunte {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
  }
  
  @media (min-width: 768px) {
    .layout-apunte {
      grid-template-columns: 250px 1fr;
    }
  }

  .sidebar-indice {
    display: none;
  }
  
  @media (min-width: 768px) {
    .sidebar-indice {
      display: block;
    }
  }

  .indice-sticky {
    position: sticky;
    top: 2rem;
    background: #1e1e1e;
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid #333;
  }
  .indice-sticky h3 {
    margin-top: 0;
    color: #fff;
    font-size: 1.1rem;
    border-bottom: 1px solid #333;
    padding-bottom: 0.5rem;
  }
  .indice-sticky ul { list-style: none; padding: 0; margin: 0; }
  .indice-sticky li { margin-bottom: 0.5rem; }
  .indice-sticky .nivel-3 { padding-left: 1rem; font-size: 0.9rem; }
  
  .indice-sticky a {
    color: #aaa;
    text-decoration: none;
    transition: color 0.2s;
  }
  .indice-sticky a:hover {
    color: var(--accent-color);
  }

  .apunte-contenido {
    background: #1e1e1e;
    padding: 2rem;
    border-radius: 8px;
    border: 1px solid #333;
  }
  .apunte-cabecera {
    border-bottom: 1px solid #333;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }
  .apunte-cabecera h1 {
    color: var(--accent-color);
    margin: 0 0 0.5rem 0;
    font-size: 2.2rem;
  }
  .fecha { color: #888; font-size: 0.9rem; margin: 0 0 1rem 0; }
  .etiqueta {
    background: var(--accent-color);
    color: var(--bg-color);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: bold;
  }
  
  .contenido-markdown h2, .contenido-markdown h3 {
    scroll-margin-top: 2rem;
    color: #fff;
    border-bottom: 1px dashed #444;
    padding-bottom: 0.5rem;
  }
  .contenido-markdown p, .contenido-markdown li {
    color: #ccc;
    line-height: 1.8;
    font-size: 1.05rem;
  }
  .zona-recompensa {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #333;
    display: flex;
    justify-content: center;
  }
  /* =========================================
     ESTILOS PREMIUM: BLOQUES DE CÓDIGO (TERMINAL)
     ========================================= */
  .contenido-markdown pre {
    background: #111 !important; /* Fondo ultra oscuro */
    border: 1px solid #333;
    border-radius: 8px;
    padding: 3rem 1rem 1rem 1rem !important; /* Mucho espacio arriba para la barra */
    position: relative;
    margin: 2rem 0;
    overflow-x: auto;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  /* Los 3 puntitos estilo Mac OS */
  .contenido-markdown pre::before {
    content: '';
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f56;
    box-shadow: 20px 0 0 #ffbd2e, 40px 0 0 #27c93f;
  }

  /* Estilos del botón flotante de copiar */
  .copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: #222;
    color: #aaa;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 0.3rem 0.8rem;
    font-size: 0.8rem;
    cursor: pointer;
    font-weight: bold;
    transition: all 0.2s;
    z-index: 10;
  }

  .copy-btn:hover {
    background: #333;
    color: #fff;
    border-color: var(--accent-color);
  }
</style>