---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotonCompletar from '../components/BotonCompletar.tsx';

const { frontmatter, headings } = Astro.props;
const indice = headings ? headings.filter((h: any) => h.depth === 2 || h.depth === 3) : [];
---

<!-- Aquí inyectamos el título y la descripción específicos del Markdown para el SEO -->
<Layout 
  title={`${frontmatter.title} | ApuntesDev`} 
  description={frontmatter.description || "Apunte de SMR para dominar este concepto y ganar XP."}
>
  <Header />
  
  <div class="progreso-contenedor">
    <div class="progreso-barra" id="barra-lectura"></div>
  </div>

  <div class="layout-apunte">
    <aside class="sidebar-indice">
      <div class="indice-sticky">
        <h3>En este apunte</h3>
        <nav>
          <ul>
            {indice.map((heading: any) => (
              <li class={`nivel-${heading.depth}`}>
                <a href={`#${heading.slug}`} class="toc-link">{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>

    <article class="apunte-contenido">
      <header class="apunte-cabecera">
        <h1>{frontmatter.title}</h1>
        <p class="fecha">Publicado el: {frontmatter.date}</p>
        <span class="etiqueta">{frontmatter.category}</span>
      </header>

      <div class="contenido-markdown">
        <slot />
      </div>
      <div class="zona-recompensa">
        <BotonCompletar client:visible idApunte={Astro.url.pathname} />
      </div>
    </article>
  </div>

  <Footer />
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    // 1. LÓGICA DE LA BARRA DE LECTURA
    const barra = document.getElementById('barra-lectura');
    if (barra) {
      const actualizarProgreso = () => {
        const alturaTotal = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrollActual = document.documentElement.scrollTop;
        const porcentaje = (scrollActual / alturaTotal) * 100;
        barra.style.width = porcentaje + '%';
      };
      window.addEventListener('scroll', actualizarProgreso);
      actualizarProgreso();
    }

    // 2. NUEVA LÓGICA: BOTÓN DE COPIAR EN CÓDIGO
    const bloquesCodigo = document.querySelectorAll('.contenido-markdown pre');
    
    bloquesCodigo.forEach((bloque) => {
      if (bloque.querySelector('.copy-btn')) return;

      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.textContent = 'Copiar';

      btn.addEventListener('click', async () => {
        const codigo = bloque.querySelector('code')?.innerText || '';
        await navigator.clipboard.writeText(codigo);
        
        btn.textContent = '¡Copiado! ✅';
        btn.style.color = 'var(--bg-color)';
        btn.style.background = 'var(--accent-color)';
        
        setTimeout(() => {
          btn.textContent = 'Copiar';
          btn.style.color = '';
          btn.style.background = '';
        }, 2000);
      });

      bloque.appendChild(btn);
    });

    // 3. NUEVA LÓGICA: ÍNDICE INTELIGENTE (SCROLLSPY)
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && entry.intersectionRatio > 0) {
          document.querySelectorAll('.toc-link').forEach(link => {
            link.classList.remove('active');
          });
          
          const id = entry.target.getAttribute('id');
          const enlaceActivo = document.querySelector(`.toc-link[href="#${id}"]`);
          if (enlaceActivo) {
            enlaceActivo.classList.add('active');
          }
        }
      });
    }, { rootMargin: '0px 0px -70% 0px' });

    document.querySelectorAll('.contenido-markdown h2, .contenido-markdown h3').forEach(heading => {
      observer.observe(heading);
    });
  });
</script>

<style is:global>
  /* Barra de lectura superior */
  .progreso-contenedor {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: transparent;
    z-index: 9999;
  }
  .progreso-barra {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-dark, var(--accent-color)), var(--accent-color));
    width: 0%;
    transition: width 0.1s ease-out;
    box-shadow: 0 0 8px var(--accent-glow);
  }

  /* Layout de dos columnas */
  .layout-apunte {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  
  @media (min-width: 900px) {
    .layout-apunte {
      grid-template-columns: 220px 1fr;
      align-items: start;
    }
  }

  .sidebar-indice {
    display: none;
  }
  
  @media (min-width: 900px) {
    .sidebar-indice {
      display: block;
    }
  }

  /* Índice lateral */
  .indice-sticky {
    position: sticky;
    top: 5rem;
    background: var(--bg-elevated);
    padding: 1.25rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
  }
  .indice-sticky h3 {
    margin-top: 0;
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.65rem;
    margin-bottom: 0.65rem;
  }
  .indice-sticky ul { list-style: none; padding: 0; margin: 0; }
  .indice-sticky li { margin-bottom: 0.1rem; }
  .indice-sticky .nivel-3 { padding-left: 0.75rem; }

  /* TOC links */
  .toc-link {
    display: block;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.35rem 0.5rem 0.35rem 0.75rem;
    border-left: 2px solid var(--border-color);
    transition: all 0.18s ease;
    font-size: 0.82rem;
    margin-bottom: 0.1rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    line-height: 1.4;
  }

  .toc-link:hover {
    color: var(--text-color);
    border-left-color: var(--text-muted);
    background: var(--bg-surface);
  }

  .toc-link.active {
    color: var(--accent-color);
    border-left-color: var(--accent-color);
    font-weight: 600;
    background: rgba(74, 222, 128, 0.07);
  }
  
  [data-theme="kali"] .toc-link.active { background: rgba(244, 63, 94, 0.08); }
  [data-theme="dracula"] .toc-link.active { background: rgba(189, 147, 249, 0.08); }
  [data-theme="matrix"] .toc-link.active { background: rgba(0, 255, 65, 0.1); }

  /* Contenido del apunte */
  .apunte-contenido {
    background: var(--bg-elevated);
    padding: 2.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    min-width: 0;
  }
  .apunte-cabecera {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }
  .apunte-cabecera h1 {
    color: var(--text-color);
    -webkit-text-fill-color: var(--text-color);
    background: none;
    margin: 0 0 0.5rem 0;
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .fecha {
    color: var(--text-muted);
    font-size: 0.82rem;
    margin: 0 0 0.75rem 0;
    font-family: var(--font-mono);
  }
  .etiqueta {
    display: inline-block;
    background: rgba(74, 222, 128, 0.12);
    color: var(--accent-color);
    padding: 0.2rem 0.65rem;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 1px solid rgba(74, 222, 128, 0.25);
  }

  /* Contenido markdown */
  .contenido-markdown h2 {
    scroll-margin-top: 5rem;
    color: var(--text-color);
    -webkit-text-fill-color: var(--text-color);
    background: none;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
    margin-top: 2.5rem;
  }
  .contenido-markdown h3 {
    scroll-margin-top: 5rem;
    color: var(--text-color);
    -webkit-text-fill-color: var(--text-color);
    background: none;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-top: 2rem;
  }
  .contenido-markdown p, .contenido-markdown li {
    color: var(--text-muted);
    line-height: 1.85;
    font-size: 1rem;
  }
  .contenido-markdown strong {
    color: var(--text-color);
    font-weight: 600;
  }
  .contenido-markdown a {
    color: var(--accent-color);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s;
  }
  .contenido-markdown a:hover {
    opacity: 0.8;
  }
  .contenido-markdown blockquote {
    border-left: 3px solid var(--accent-color);
    padding: 0.75rem 1.25rem;
    margin: 1.5rem 0;
    background: rgba(74, 222, 128, 0.04);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .contenido-markdown blockquote p {
    margin: 0;
    color: var(--text-muted);
    font-style: italic;
  }

  /* Zona de recompensa */
  .zona-recompensa {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: center;
  }

  /* Bloques de código (estilo terminal) */
  .contenido-markdown pre {
    background: var(--code-bg) !important;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2.75rem 1.25rem 1.25rem !important;
    position: relative;
    margin: 1.75rem 0;
    overflow-x: auto;
    box-shadow: var(--shadow-md);
  }

  /* Botones MacOS */
  .contenido-markdown pre::before {
    content: '';
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f56;
    box-shadow: 18px 0 0 #ffbd2e, 36px 0 0 #27c93f;
  }

  .copy-btn {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    background: var(--bg-elevated);
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.65rem;
    font-size: 0.72rem;
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: all 0.2s;
    z-index: 10;
  }

  .copy-btn:hover {
    background: var(--accent-color);
    color: var(--bg-color);
    border-color: var(--accent-color);
    box-shadow: 0 0 10px var(--accent-glow);
  }

  @media (max-width: 768px) {
    .apunte-contenido { padding: 1.5rem; }
  }
</style>