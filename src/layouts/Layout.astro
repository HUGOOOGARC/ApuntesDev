---
import { ClientRouter } from 'astro:transitions';
import CommandPalette from '../components/CommandPalette.tsx';
import Toast from '../components/Toast.astro';
import PWAInstallPrompt from '../components/PWAInstallPrompt.tsx';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article"; // Útil para SEO de apuntes individuales
  author?: string;
}

// Valores por defecto robustos
const { 
  title, 
  description = "Aprende Sistemas Operativos, Redes y Programación. Completa apuntes, gana XP y sube de nivel en esta plataforma gamificada de élite.",
  image = "/og-image.png",
  type = "website",
  author = "ApuntesDev"
} = Astro.props;

// URL base de producción (Asegúrate de que coincide con tu dominio final)
const BASE_URL = "https://apuntes-dev-six.vercel.app";
const canonicalURL = new URL(Astro.url.pathname, BASE_URL).toString();

// Resolutor absoluto de imágenes
const socialImageURL = image.startsWith('http') 
  ? image 
  : new URL(image, BASE_URL).toString();
---

<!doctype html>
<html lang="es" class="antialiased">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <meta name="theme-color" content="#4ade80" />
  <meta name="generator" content={Astro.generator} />
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  
  <!-- Configuración PWA y Web App Manifest -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="ApuntesDev" />
  <meta name="application-name" content="ApuntesDev" />
  <meta name="msapplication-TileColor" content="#0a0a0f" />
  
  <!-- SEO Técnico y Metadatos -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={author} />
  <link rel="canonical" href={canonicalURL} />
  
  <!-- Open Graph / Facebook / LinkedIn -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:site_name" content="ApuntesDev" />
  <meta property="og:locale" content="es_ES" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageURL} />
  
  <!-- Preloads para rendimiento (Opcional, ajusta la ruta si usas fuentes locales) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Enrutador SPA de Astro (ViewTransitions) -->
  <ClientRouter />

  <!-- Tema Persistente Anti-Flash (Optimizado) -->
  <script is:inline>
    const themeScript = () => {
      try {
        const rawData = localStorage.getItem('apuntesdev_perfil:');
        if (rawData) {
          const perfil = JSON.parse(rawData);
          if (perfil.temaActivo) {
            document.documentElement.setAttribute('data-theme', perfil.temaActivo);
            return;
          }
        }
      } catch (e) { console.error("Error al cargar tema", e); }
      
      // Fallback a preferencias del sistema
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.setAttribute('data-theme', 'default');
      }
    };
    
    themeScript();
    document.addEventListener('astro:after-swap', themeScript);
  </script>
</head>

<body>
  <!-- Paleta de comandos rápida (Ctrl + K) -->
  <CommandPalette client:load />

  <!-- Contenedor Principal a Pantalla Completa (Full-Width) -->
  <div id="site-root" class="site-root">
    <slot />
  </div>

  <!-- Sistema Flotante de Notificaciones (Toasts Cyberpunk) -->
  <Toast />

  <!-- Sistema de Scroll Reveal & Efectos Magnéticos -->
  <script>
    // ── SCROLL REVEAL SYSTEM ──
    const initScrollReveal = () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach((el) => {
        observer.observe(el);
      });
    };

    // ── EFECTO MAGNÉTICO EN BOTONES ──
    const initMagneticButtons = () => {
      document.querySelectorAll('.magnetic').forEach((btn) => {
        btn.addEventListener('mousemove', (e) => {
          const rect = btn.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          const strength = 0.35;
          btn.style.transform = `translate(${x * strength}px, ${y * strength}px)`;
        });
        btn.addEventListener('mouseleave', () => {
          btn.style.transform = '';
          btn.style.transition = 'transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
          setTimeout(() => { btn.style.transition = ''; }, 500);
        });
      });
    };

    // ── CONTADOR ANIMADO ──
    const animateCounter = (el) => {
      const target = parseInt(el.getAttribute('data-target') || el.textContent, 10);
      if (isNaN(target)) return;
      const duration = 1200;
      const start = performance.now();
      const update = (now) => {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(eased * target).toLocaleString('es-ES');
        if (progress < 1) requestAnimationFrame(update);
      };
      requestAnimationFrame(update);
    };

    const initCounters = () => {
      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCounter(entry.target);
            counterObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });
      document.querySelectorAll('.counter-num').forEach((el) => counterObserver.observe(el));
    };

    // ── TILT 3D EN TARJETAS ──
    const initTilt = () => {
      document.querySelectorAll('.tilt-card').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;
          card.style.transform = `perspective(800px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg) translateZ(8px)`;
        });
        card.addEventListener('mouseleave', () => {
          card.style.transform = '';
          card.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
          setTimeout(() => { card.style.transition = ''; }, 600);
        });
      });
    };

    document.addEventListener('astro:page-load', () => {
      initScrollReveal();
      initMagneticButtons();
      initCounters();
      initTilt();
    });
  </script>

  <!-- Interactividad UX: Copiar Código -->
  <script>
    const inicializarBotonesCopiar = () => {
      const bloquesDeCodigo = document.querySelectorAll('pre');

      bloquesDeCodigo.forEach((bloque) => {
        if (bloque.querySelector('.boton-copiar')) return;

        // Mejor accesibilidad y posicionamiento relacional
        bloque.style.position = 'relative';

        const botonCopiar = document.createElement('button');
        botonCopiar.className = 'boton-copiar';
        botonCopiar.setAttribute('aria-label', 'Copiar código al portapapeles');
        botonCopiar.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> <span>Copiar</span>`;
        
        bloque.appendChild(botonCopiar);

        botonCopiar.addEventListener('click', async () => {
          const codeElement = bloque.querySelector('code');
          const codigo = codeElement ? codeElement.innerText : bloque.innerText;
          
          if (codigo) {
            try {
              await navigator.clipboard.writeText(codigo);
              const span = botonCopiar.querySelector('span');
              if (span) span.innerText = 'Copiado';
              botonCopiar.classList.add('copiado');
              
              setTimeout(() => {
                if (span) span.innerText = 'Copiar';
                botonCopiar.classList.remove('copiado');
              }, 2000);
            } catch (err) {
              console.error('Fallo al copiar', err);
            }
          }
        });
      });
    };

    // Ejecutar en carga inicial y en navegaciones SPA
    document.addEventListener('astro:page-load', inicializarBotonesCopiar);
  </script>

  <!-- Sync Cloud (Supabase) -->
  <script>
    import { cargarPerfilDesdeSupabase } from '../store/progreso';
    import { supabase } from '../lib/supabase';

    document.addEventListener('astro:page-load', async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        await cargarPerfilDesdeSupabase();
      }
    });
  </script>

  <!-- Banner Flotante de Instalación PWA (Móvil y Escritorio) -->
  <PWAInstallPrompt client:idle />

  <!-- Registro de Service Worker PWA -->
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
          .then((reg) => {
            console.log('ApuntesDev PWA Service Worker registrado correctamente');
          })
          .catch((err) => {
            console.warn('Fallo al registrar Service Worker PWA:', err);
          });
      });
    }
  </script>
</body>
</html>

<style is:global>
  /* =========================================
     VARIABLES GLOBALES Y SISTEMA DE TEMAS
     ========================================= */
  :root {
    --bg-color: #0a0a0f;
    --bg-surface: #111118;
    --bg-elevated: #18181f;
    --text-color: #e8e8f0;
    --text-muted: #8888a0;
    --accent-color: #4ade80;
    --accent-dark: #22c55e;
    --accent-glow: rgba(74, 222, 128, 0.35);
    --code-bg: #0d0d14;
    --border-color: #2a2a38;
    --border-subtle: #1e1e28;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --radius-xl: 20px;
    
    --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.4);
    --shadow-md: 0 4px 16px rgba(0,0,0,0.5);
    --shadow-lg: 0 8px 32px rgba(0,0,0,0.6);
    --shadow-glow: 0 0 24px var(--accent-glow);
  }

  /* Temas de la Tienda Endgame */
  [data-theme="kali"] {
    --bg-color: #0a0005;
    --bg-surface: #120008;
    --bg-elevated: #1a000d;
    --accent-color: #f43f5e;
    --accent-dark: #e11d48;
    --accent-glow: rgba(244, 63, 94, 0.35);
    --border-color: #3f0a1a;
    --border-subtle: #2a0510;
  }

  [data-theme="dracula"] {
    --bg-color: #1e1f2b;
    --bg-surface: #252637;
    --bg-elevated: #2d2e45;
    --text-color: #f8f8f2;
    --text-muted: #6272a4;
    --accent-color: #bd93f9;
    --accent-dark: #a580f7;
    --accent-glow: rgba(189, 147, 249, 0.35);
    --code-bg: #191a27;
    --border-color: #3a3c58;
    --border-subtle: #2d2e45;
  }

  [data-theme="matrix"] {
    --bg-color: #000000;
    --bg-surface: #050805;
    --bg-elevated: #0a110a;
    --text-color: #00e676;
    --text-muted: #00701a;
    --accent-color: #00ff41;
    --accent-dark: #00cc33;
    --accent-glow: rgba(0, 255, 65, 0.4);
    --code-bg: #020302;
    --border-color: #004d10;
    --border-subtle: #002a08;
  }
  
  [data-theme="cyberpunk"] {
    --bg-color: #05050f;
    --bg-surface: #0c0c1e;
    --bg-elevated: #121228;
    --text-color: #e0e0ff;
    --text-muted: #8080c0;
    --accent-color: #f9e800;
    --accent-dark: #d4c200;
    --accent-glow: rgba(249, 232, 0, 0.35);
    --code-bg: #030308;
    --border-color: #2a2a60;
    --border-subtle: #1a1a40;
  }

  /* =========================================
     RESETS Y BASE
     ========================================= */
  *, *::before, *::after {
    box-sizing: border-box;
  }
  
  .antialiased {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  html {
    font-family: var(--font-sans);
    background-color: var(--bg-color);
    color: var(--text-color);
    line-height: 1.6;
    scroll-behavior: smooth;
    transition: background-color 0.3s ease, color 0.3s ease;
    font-size: 16px;
    letter-spacing: -0.01em;
  }

  body {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-image: 
      radial-gradient(ellipse 80% 50% at 50% -20%, rgba(74, 222, 128, 0.07), transparent),
      radial-gradient(ellipse 60% 40% at 80% 80%, rgba(74, 222, 128, 0.04), transparent);
    background-attachment: fixed;
  }

  /* Mejora de accesibilidad para el salto al contenido */
  #main-content:focus {
    outline: none;
  }

  .site-root {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
    position: relative;
    overflow-x: hidden;
  }

  main {
    flex-grow: 1;
    width: 100%;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* =========================================
     TYPOGRAPHY Y CÓDIGO
     ========================================= */
  code {
    font-family: var(--font-mono);
    background-color: var(--bg-elevated);
    padding: 0.18em 0.45em;
    border-radius: var(--radius-sm);
    font-size: 0.88em;
    color: var(--accent-color);
    border: 1px solid var(--border-color);
  }

  pre {
    background-color: var(--code-bg) !important;
    padding: 3rem 1.5rem 1.5rem 1.5rem !important; 
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    overflow-x: auto;
    box-shadow: var(--shadow-md), inset 0 1px 0 rgba(255,255,255,0.03);
  }

  pre code {
    background-color: transparent;
    padding: 0;
    border-radius: 0;
    color: inherit;
    border: none;
  }

  .boton-copiar {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--bg-elevated);
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.75rem;
    font-size: 0.75rem;
    font-family: var(--font-sans);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 10;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .boton-copiar:hover {
    background-color: var(--accent-color);
    color: var(--bg-color);
    border-color: var(--accent-color);
    box-shadow: 0 0 12px var(--accent-glow);
    transform: translateY(-1px);
  }

  .boton-copiar.copiado {
    background-color: var(--accent-color);
    color: var(--bg-color);
    border-color: var(--accent-color);
  }

  /* =========================================
     HUD Y PROGRESO (BARRA SUPERIOR)
     ========================================= */
  .hud-wrapper {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 10, 15, 0.75);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border-color);
    box-shadow: 0 1px 0 rgba(255,255,255,0.03), var(--shadow-sm);
  }

  .hud-container { 
    max-width: 1140px; 
    width: 100%;
    margin: 0 auto; 
    display: flex; 
    justify-content: flex-end; 
    padding: 0.65rem 1.5rem; 
  }

  .xp-hud { 
    display: flex; 
    align-items: center; 
    gap: 10px; 
    background: var(--bg-elevated); 
    padding: 0.45rem 1rem; 
    border-radius: var(--radius-lg); 
    border: 1px solid var(--border-color); 
    box-shadow: var(--shadow-sm), inset 0 1px 0 rgba(255,255,255,0.05);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .xp-hud:hover {
    border-color: var(--accent-color);
    box-shadow: var(--shadow-sm), 0 0 16px var(--accent-glow);
  }

  .nivel-badge { 
    font-weight: 800; 
    color: var(--bg-color); 
    background: var(--accent-color); 
    padding: 0.2rem 0.65rem; 
    border-radius: var(--radius-sm); 
    font-size: 0.82rem; 
    display: flex; 
    align-items: center; 
    gap: 4px;
    box-shadow: 0 0 10px var(--accent-glow);
    letter-spacing: 0.03em;
  }\n
  .prestigio-estrella { font-size: 0.75rem; filter: drop-shadow(0 0 3px rgba(255, 215, 0, 0.9)); }
  
  .xp-barra-fondo { 
    width: 130px; 
    height: 6px; 
    background: rgba(0,0,0,0.5); 
    border-radius: 10px; 
    overflow: hidden; 
    border: 1px solid var(--border-subtle);
  }
  
  .xp-barra-relleno { 
    height: 100%; 
    background: linear-gradient(90deg, var(--accent-dark), var(--accent-color));
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); 
    box-shadow: 0 0 8px var(--accent-glow); 
    border-radius: 10px;
  }
  
  .xp-texto { 
    font-size: 0.75rem; 
    color: var(--text-muted); 
    font-family: var(--font-mono); 
    font-weight: 600; 
    width: 75px; 
    text-align: right;
    letter-spacing: 0.02em;
  }
  
  .monedas-badge { 
    background: rgba(255, 215, 0, 0.08); 
    color: #FFD700; 
    padding: 0.2rem 0.6rem; 
    border-radius: var(--radius-sm); 
    font-weight: 700; 
    font-family: var(--font-mono); 
    font-size: 0.82rem;
    border: 1px solid rgba(255, 215, 0, 0.2); 
    letter-spacing: 0.03em;
  }

  .cristales-badge { 
    background: rgba(0, 220, 255, 0.08); 
    color: #00dcff; 
    padding: 0.2rem 0.6rem; 
    border-radius: var(--radius-sm); 
    font-weight: 700; 
    font-family: var(--font-mono); 
    font-size: 0.82rem;
    border: 1px solid rgba(0, 220, 255, 0.2); 
    letter-spacing: 0.03em;
  }

  /* =========================================
     BOTONES GAMIFICADOS
     ========================================= */
  .btn-completar { 
    background: transparent; 
    color: var(--accent-color); 
    border: 2px solid var(--accent-color); 
    padding: 1rem 2.5rem; 
    font-size: 1rem; 
    border-radius: var(--radius-md); 
    cursor: pointer; 
    font-weight: 700; 
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); 
    margin-top: 3rem; 
    display: flex; 
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%; 
    max-width: 400px; 
    margin-inline: auto; 
    box-shadow: 0 0 0 0 var(--accent-glow);
  }

  .btn-completar:hover:not(:disabled) { 
    background: var(--accent-color); 
    color: var(--bg-color); 
    transform: translateY(-2px); 
    box-shadow: 0 8px 24px var(--accent-glow);
  }
  
  .btn-completar.dominado { 
    background: rgba(74, 222, 128, 0.08);
    color: var(--accent-color); 
    border-color: var(--border-color);
    opacity: 0.75; 
    cursor: default; 
    transform: none; 
    box-shadow: none;
  }

  /* =========================================
     PALETA DE COMANDOS (CTRL+K)
     ========================================= */
  .cmd-backdrop {
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
    z-index: 100000;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 10vh;
    animation: fadeIn 0.15s ease-out;
  }
  
  .cmd-modal {
    width: 100%;
    max-width: 620px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    box-shadow: 0 32px 64px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(74, 222, 128, 0.1);
    overflow: hidden;
    animation: slideDown 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cmd-header {
    display: flex;
    align-items: center;
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid var(--border-color);
    background: rgba(0,0,0,0.25);
    gap: 0.75rem;
  }

  .cmd-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-color);
    font-size: 1.1rem;
    outline: none;
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  
  .cmd-input::placeholder { color: var(--text-muted); }

  .cmd-esc {
    font-size: 0.7rem;
    color: var(--text-muted);
    background: var(--bg-surface);
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
