---
import { ClientRouter } from 'astro:transitions';
import BarraProgreso from '../components/BarraProgreso.tsx';
import CommandPalette from '../components/CommandPalette.tsx';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

// Recibimos los datos de la página actual, o ponemos la imagen og-image
const { 
	title, 
	description = "Aprende Sistemas Operativos, Redes y Programación. Completa apuntes, gana XP y sube de nivel en esta plataforma gamificada.",
	image = "/og-image.png" 
} = Astro.props;

// 1. URL base de tu web en producción (¡Cámbiala por tu subdominio de Vercel exacto!)
// Pon https://apuntes-dev-six.vercel.app sin la barra diagonal del final.
const BASE_URL = "https://apuntes-dev-six.vercel.app";

const canonicalURL = new URL(Astro.url.pathname, BASE_URL);

// 2. Aquí forzamos la URL absoluta de la imagen para que Discord la encuentre de verdad
// Si la imagen ya tiene http:// o https:// la dejamos, si no, le pegamos tu dominio delante
const socialImageURL = image.startsWith('http') 
  ? image 
  : `${BASE_URL}${image}`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<!-- SEO Básico -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph (WhatsApp, Facebook, Discord, LinkedIn) -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<ClientRouter />

		<!-- Script ant-parpadeo de la tienda de temas -->
		<script is:inline>
			const rawData = localStorage.getItem('apuntes_perfil');
			if (rawData) {
				try {
					const perfil = JSON.parse(rawData);
					if (perfil.temaActivo) {
						document.documentElement.setAttribute('data-theme', perfil.temaActivo);
					}
				} catch (e) {}
			}
		</script>
	</head>
	<body>
		<CommandPalette client:load />
		<div class="hud-container">
			<BarraProgreso client:load />
		</div>
		<main>
			<slot /> 
		</main>

		<!-- Botón de copiar adaptado a ViewTransitions -->
		<script>
		  document.addEventListener('astro:page-load', () => {
		    const bloquesDeCodigo = document.querySelectorAll('pre');

		    bloquesDeCodigo.forEach((bloque) => {
		      // Evitamos duplicar botones si la página recarga transiciones
		      if (bloque.querySelector('.boton-copiar')) return;

		      const botonCopiar = document.createElement('button');
		      botonCopiar.className = 'boton-copiar';
		      botonCopiar.innerText = 'Copiar';
		      bloque.appendChild(botonCopiar);

		      botonCopiar.addEventListener('click', async () => {
		        const codigo = bloque.querySelector('code')?.innerText;
		        if (codigo) {
		          await navigator.clipboard.writeText(codigo);
		          botonCopiar.innerText = '¡Copiado!';
		          setTimeout(() => {
		            botonCopiar.innerText = 'Copiar';
		          }, 2000);
		        }
		      });
		    });
		  });
		</script>
		<!-- Sincronización automática del perfil con Supabase -->
		<script>
			import { cargarPerfilDesdeSupabase } from '../store/progreso';
			import { supabase } from '../lib/supabase';

			document.addEventListener('astro:page-load', async () => {
				const { data: { session } } = await supabase.auth.getSession();
				if (session) {
					await cargarPerfilDesdeSupabase();
				}
			});
		</script>
	</body>
</html>

<style is:global>
/* Tema por defecto (Terminal Verde) */
  :root {
    --bg-color: #121212;
    --text-color: #e0e0e0;
    --accent-color: #4CAF50; 
  }

  /* Tema Kali Linux */
  [data-theme="kali"] {
    --bg-color: #0d0d0d;
    --accent-color: #e53935;
  }

  /* Tema Drácula */
  [data-theme="dracula"] {
    --bg-color: #282a36;
    --text-color: #f8f8f2;
    --accent-color: #bd93f9;
  }

  /* Tema Hacker / Matrix */
  [data-theme="hacker"] {
    --bg-color: #000000;
    --text-color: #00ff00;
    --accent-color: #00ff00;
  }
	html {
		font-family: system-ui, -apple-system, sans-serif;
		background-color: var(--bg-color);
		color: var(--text-color);
		line-height: 1.6;
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	main {
		margin: auto;
		padding: 2rem;
		width: 100%;
		max-width: 1000px;
		flex-grow: 1;
	}
	code {
		font-family: Menlo, Monaco, Lucida Console, monospace;
		background-color: var(--code-bg);
		padding: 0.2rem 0.4rem;
		border-radius: 4px;
	}

	pre {
		position: relative;
		padding-top: 2.5rem !important; 
	}
	.boton-copiar {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		background-color: var(--accent-color);
		color: var(--bg-color);
		border: none;
		border-radius: 4px;
		padding: 0.25rem 0.75rem;
		font-size: 0.8rem;
		font-family: inherit;
		font-weight: bold;
		cursor: pointer;
		transition: opacity 0.2s ease;
		opacity: 0.8;
	}
	.boton-copiar:hover {
		opacity: 1;
	}
	.hud-container { max-width: 1000px; margin: 0 auto 2rem auto; display: flex; justify-content: flex-end; padding: 0 2rem; }
	.xp-hud { display: flex; align-items: center; gap: 12px; background: #1a1a1a; padding: 0.6rem 1.2rem; border-radius: 8px; border: 1px solid #333; box-shadow: 0 4px 6px rgba(0,0,0,0.3); }
	.nivel-badge { font-weight: bold; color: var(--bg-color); background: var(--accent-color); padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.9rem; display: flex; align-items: center; gap: 4px; }
	.prestigio-estrella { font-size: 0.8rem; }
	.xp-barra-fondo { width: 150px; height: 12px; background: #2a2a2a; border-radius: 6px; overflow: hidden; box-shadow: inset 0 1px 3px rgba(0,0,0,0.5); }
	.xp-barra-relleno { height: 100%; background: linear-gradient(90deg, #4CAF50, #81C784); transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 0 10px rgba(76, 175, 80, 0.5); }
	.xp-texto { font-size: 0.8rem; color: #aaa; font-family: monospace; font-weight: bold; width: 80px; text-align: right; }
	.monedas-badge { background: #333; color: #FFD700; padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: bold; font-family: monospace; border: 1px solid #555; }

	/* Estilos globales para el botón de completar */
	.btn-completar { background: #2a2a2a; color: #fff; border: 2px solid var(--accent-color); padding: 1rem 2rem; font-size: 1.1rem; border-radius: 8px; cursor: pointer; font-weight: bold; transition: all 0.2s ease; margin-top: 2rem; display: block; width: 100%; max-width: 400px; margin-inline: auto; }
	.btn-completar:hover:not(:disabled) { background: var(--accent-color); color: var(--bg-color); transform: translateY(-2px); }
	.btn-completar.dominado { background: var(--accent-color); color: var(--bg-color); opacity: 0.7; border-color: transparent; cursor: default; transform: none; }

	/* =========================================
     ESTILOS PREMIUM: PALETA DE COMANDOS (CTRL+K)
     ========================================= */
  .cmd-backdrop {
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 100000; /* Siempre por encima de todo */
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding-top: 15vh;
    animation: fadeIn 0.2s ease-out;
  }
  
  .cmd-modal {
    width: 100%;
    max-width: 600px;
    background: #111;
    border: 1px solid #333;
    border-radius: 12px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px var(--accent-color);
    overflow: hidden;
    animation: slideDown 0.2s ease-out;
  }

  .cmd-header {
    display: flex;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid #333;
  }

  .cmd-input {
    flex: 1;
    background: transparent;
    border: none;
    color: #fff;
    font-size: 1.2rem;
    outline: none;
    font-family: inherit;
  }
  
  .cmd-input::placeholder { color: #555; }

  .cmd-esc {
    font-size: 0.7rem;
    color: #666;
    background: #222;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #333;
    font-weight: bold;
    letter-spacing: 1px;
  }

  .cmd-results {
    max-height: 400px;
    overflow-y: auto;
    padding: 0.5rem;
  }

  .cmd-item {
    display: block;
    padding: 1rem;
    color: #ccc;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.1s ease;
    margin-bottom: 0.2rem;
  }

  .cmd-item:hover {
    background: var(--accent-color);
    color: var(--bg-color);
    font-weight: bold;
  }

  .cmd-empty {
    padding: 2rem;
    text-align: center;
    color: #666;
  }

  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slideDown { from { transform: translateY(-20px) scale(0.98); opacity: 0; } to { transform: translateY(0) scale(1); opacity: 1; } }


</style>