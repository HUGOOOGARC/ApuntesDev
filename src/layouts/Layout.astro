---
// Cambiamos ViewTransitions por ClientRouter para Astro 5+
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Apuntes de SMR y Programación" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<!-- Usamos la nueva etiqueta -->
		<ClientRouter />
	</head>
	<body>
		<main>
			<slot /> 
		</main>

		<!-- Botón de copiar adaptado a ViewTransitions -->
		<script>
		  document.addEventListener('astro:page-load', () => {
		    const bloquesDeCodigo = document.querySelectorAll('pre');

		    bloquesDeCodigo.forEach((bloque) => {
		      // Evitamos duplicar botones si la página recarga transiciones
		      if (bloque.querySelector('.boton-copiar')) return;

		      const botonCopiar = document.createElement('button');
		      botonCopiar.className = 'boton-copiar';
		      botonCopiar.innerText = 'Copiar';
		      bloque.appendChild(botonCopiar);

		      botonCopiar.addEventListener('click', async () => {
		        const codigo = bloque.querySelector('code')?.innerText;
		        if (codigo) {
		          await navigator.clipboard.writeText(codigo);
		          botonCopiar.innerText = '¡Copiado!';
		          setTimeout(() => {
		            botonCopiar.innerText = 'Copiar';
		          }, 2000);
		        }
		      });
		    });
		  });
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg-color: #121212;
		--text-color: #e0e0e0;
		--accent-color: #4CAF50;
		--code-bg: #1e1e1e;
	}
	html {
		font-family: system-ui, -apple-system, sans-serif;
		background-color: var(--bg-color);
		color: var(--text-color);
		line-height: 1.6;
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	main {
		margin: auto;
		padding: 2rem;
		width: 100%;
		max-width: 1000px;
		flex-grow: 1;
	}
	code {
		font-family: Menlo, Monaco, Lucida Console, monospace;
		background-color: var(--code-bg);
		padding: 0.2rem 0.4rem;
		border-radius: 4px;
	}

	pre {
		position: relative;
		padding-top: 2.5rem !important; 
	}
	.boton-copiar {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		background-color: var(--accent-color);
		color: var(--bg-color);
		border: none;
		border-radius: 4px;
		padding: 0.25rem 0.75rem;
		font-size: 0.8rem;
		font-family: inherit;
		font-weight: bold;
		cursor: pointer;
		transition: opacity 0.2s ease;
		opacity: 0.8;
	}
	.boton-copiar:hover {
		opacity: 1;
	}
</style>